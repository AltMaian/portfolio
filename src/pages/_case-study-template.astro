---
// src/pages/[slug].astro
// Template for individual case study pages
import Layout from '../layouts/Layout.astro';

// Example data - replace with actual case study content
const caseStudy = {
  title: "Julkisten palveluiden saavutettavuus",
  subtitle: "Miten voimme tehdä kriittisistä palveluista helpompia käyttää silloin kun elämä on hektistä?",
  date: "Maaliskuu 2024",
  category: "Saavutettavuus",
  tags: ["WCAG", "Julkiset palvelut", "UX Research"],
  readTime: "8 min"
};
---

<Layout title={`${caseStudy.title} | altmaian.dev`}>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Etusivu</a>
          <span class="separator">→</span>
          <a href="/case-studies">Case Studies</a>
          <span class="separator">→</span>
          <span class="current">{caseStudy.title}</span>
        </div>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">{caseStudy.readTime}</span>
          </div>

          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>

          <div class="tags">
            {caseStudy.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <article class="content-section">
      <div class="container">
        <div class="article-content">
          
          <!-- Summary -->
          <section class="section">
            <h2>Yhteenveto</h2>
            <div class="summary-box">
              <p>
                Tämä case study tarkastelee miten julkiset palvelut voivat parantaa 
                saavutettavuuttaan keskittymällä todellisiin käyttötilanteisiin - 
                väsyneisiin vanhempiin, kiireisiin työntekijöihin, ja stressaantuneisiin 
                kansalaisiin.
              </p>
            </div>
          </section>

          <!-- Problem -->
          <section class="section">
            <h2>Ongelma</h2>
            <p>
              Monet julkiset palvelut täyttävät WCAG-vaatimukset teknisesti, mutta 
              epäonnistuvat käytännössä. Käyttäjät kohtaavat palveluita:
            </p>
            <ul>
              <li>Väsyneinä iltapäivällä lapset nukkumaan laitettuaan</li>
              <li>Kiireisinä tauolla töistä</li>
              <li>Stressaantuneina kun deadline lähestyy</li>
              <li>Hajamielisinä kun monta asiaa mielessä</li>
            </ul>
          </section>

          <!-- Research -->
          <section class="section">
            <h2>Tutkimus</h2>
            <p>
              Haastattelin 15 vanhempaa jotka käyttävät julkisia palveluita säännöllisesti. 
              Kysyin heiltä:
            </p>
            <div class="quote-box">
              <p class="quote">
                "Milloin yleensä täytät lomakkeita? Missä tilanteessa? 
                Mitä muuta teet samaan aikaan?"
              </p>
            </div>
            <p>
              Tulokset olivat silmiä avaavia. 80% täytti lomakkeita iltaisin, 
              lasten nukkumaanmenon jälkeen. Useimmat tekivät samalla muuta - 
              katsoivat TV:tä, söivät, tai vastasivat viesteihin.
            </p>
          </section>

          <!-- Solution -->
          <section class="section">
            <h2>Ratkaisu</h2>
            <p>
              Suunnittelin prototyypin joka ottaa huomioon nämä todellisuudet:
            </p>
            
            <div class="feature-grid">
              <div class="feature-card">
                <h3>Auto-save</h3>
                <p>
                  Lomake tallentuu automaattisesti. Jos lapsi herää kesken täytön, 
                  voit jatkaa myöhemmin siitä mihin jäit.
                </p>
              </div>

              <div class="feature-card">
                <h3>Selkeä edistyminen</h3>
                <p>
                  Näet aina missä kohtaa olet. Ei yllätyksiä, ei piilotettuja 
                  pakollisia kenttiä.
                </p>
              </div>

              <div class="feature-card">
                <h3>Empaattiset virheet</h3>
                <p>
                  "Tämä kenttä tarvitsee henkilötunnuksen muodossa ppkkvv-xxxx" 
                  ei "Virheellinen syöte".
                </p>
              </div>

              <div class="feature-card">
                <h3>Yksi asia kerrallaan</h3>
                <p>
                  Ei pitkiä sivuja täynnä kenttiä. Pieni kognitiivinen kuorma 
                  per näkymä.
                </p>
              </div>
            </div>
          </section>

          <!-- Results -->
          <section class="section">
            <h2>Tulokset</h2>
            <p>
              Testaus 10 käyttäjällä osoitti merkittäviä parannuksia:
            </p>
            
            <div class="results-grid">
              <div class="result-card">
                <div class="metric">85%</div>
                <div class="metric-label">Vähemmän keskeytettyjä lomakkeita</div>
              </div>
              <div class="result-card">
                <div class="metric">3.2 min</div>
                <div class="metric-label">Nopeampi täyttöaika keskimäärin</div>
              </div>
              <div class="result-card">
                <div class="metric">92%</div>
                <div class="metric-label">Käyttäjätyytyväisyys</div>
              </div>
            </div>
          </section>

          <!-- Learnings -->
          <section class="section">
            <h2>Oppimia asioita</h2>
            <div class="learnings-box">
              <h3>Mikä toimi:</h3>
              <ul>
                <li>Auto-save oli ylivoimaisesti arvostetuin ominaisuus</li>
                <li>Selkeä edistymispalkki vähensi ahdistusta</li>
                <li>Empaattiset virheviestit vähensivät turhautumista</li>
              </ul>

              <h3>Mikä ei toiminut:</h3>
              <ul>
                <li>Liian monta vaihtoehtoa per sivu - käyttäjät jumittivat</li>
                <li>Tekninen kieli hämmensi (esim. "validoi syöte")</li>
                <li>Popup-vahvistukset keskeyttivät työnkulun</li>
              </ul>

              <h3>Mitä tekisin toisin:</h3>
              <ul>
                <li>Testaisin käyttäjiä heidän todellisessa ympäristössään (kotona)</li>
                <li>Lisäisin "tallenna ja jatka myöhemmin" -napin jokaiselle sivulle</li>
                <li>Antaisin käyttäjien valita lomakkeen täyttötavan (pitkä vs. vaiheittainen)</li>
              </ul>
            </div>
          </section>

          <!-- Conclusion -->
          <section class="section">
            <h2>Johtopäätökset</h2>
            <p>
              Saavutettavuus ei ole vain tekninen checklist. Se on ymmärrystä siitä, 
              että käyttäjät ovat <em>oikeita ihmisiä oikeissa tilanteissa</em>.
            </p>
            <p>
              WCAG-standardit ovat tärkeä perusta, mutta ne eivät riitä. Meidän täytyy 
              suunnitella palveluita jotka toimivat myös kun:
            </p>
            <ul>
              <li>Lapsi huutaa taustalla</li>
              <li>Puhelin soi</li>
              <li>Olet väsynyt</li>
              <li>Sinulla on kiire</li>
              <li>Keskittymiskyky on nollissa</li>
            </ul>
            <p>
              <strong>Hyvä saavutettavuus on empatiaa koodina.</strong>
            </p>
          </section>

        </div>

        <!-- Sidebar (optional) -->
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3>Projektin tiedot</h3>
            <dl class="details-list">
              <dt>Rooli</dt>
              <dd>UX Research, UI Design</dd>
              
              <dt>Aika</dt>
              <dd>3 viikkoa</dd>
              
              <dt>Työkalut</dt>
              <dd>Figma, Maze, Google Forms</dd>
              
              <dt>Tiimi</dt>
              <dd>Solo-projekti</dd>
            </dl>
          </div>

          <div class="sidebar-section">
            <h3>Liittyvät artikkelit</h3>
            <ul class="related-links">
              <li><a href="#">Empaattiset virheviestit</a></li>
              <li><a href="#">Auto-save käytännössä</a></li>
              <li><a href="#">WCAG AA vs. todellinen käytettävyys</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </article>

    <!-- Navigation -->
    <section class="case-nav">
      <div class="container">
        <div class="nav-links">
          <a href="#" class="nav-link prev">
            <span class="nav-label">Edellinen</span>
            <span class="nav-title">Auto-save käytännössä</span>
          </a>
          <a href="/case-studies" class="nav-link center">
            Kaikki case studyt
          </a>
          <a href="#" class="nav-link next">
            <span class="nav-label">Seuraava</span>
            <span class="nav-title">Empaattiset virheviestit</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables
     ============================================ */
  :root {
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --font-display: 'Space Mono', monospace;
    --font-body: 'JetBrains Mono', monospace;
  }

  main {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ============================================
     Hero
     ============================================ */
  .hero {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-turquoise);
  }

  .breadcrumb .separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .meta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .category {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .date,
  .read-time {
    color: var(--color-text-muted);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  /* ============================================
     Content Section
     ============================================ */
  .content-section {
    padding: var(--spacing-lg) 0;
  }

  .content-section .container {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--spacing-lg);
  }

  .article-content {
    max-width: 800px;
  }

  /* ============================================
     Typography
     ============================================ */
  .section {
    margin-bottom: var(--spacing-lg);
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-accent-turquoise);
  }

  .section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .section p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .section ul,
  .section ol {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .section li {
    margin-bottom: 0.5rem;
  }

  .section strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .section em {
    color: var(--color-accent-turquoise);
    font-style: italic;
  }

  /* ============================================
     Special Boxes
     ============================================ */
  .summary-box {
    background: rgba(6, 214, 160, 0.08);
    border-left: 4px solid var(--color-accent-turquoise);
    padding: var(--spacing-md);
    border-radius: 0 4px 4px 0;
    margin-bottom: var(--spacing-md);
  }

  .summary-box p {
    margin: 0;
    color: var(--color-text);
  }

  .quote-box {
    background: var(--color-bg-secondary);
    border-left: 4px solid var(--color-accent-purple);
    padding: var(--spacing-md);
    margin: var(--spacing-md) 0;
    border-radius: 0 4px 4px 0;
  }

  .quote {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-text);
    margin: 0;
  }

  .learnings-box {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .learnings-box h3 {
    color: var(--color-accent-turquoise);
    margin-top: var(--spacing-md);
  }

  .learnings-box h3:first-child {
    margin-top: 0;
  }

  .learnings-box ul {
    margin-bottom: 0;
  }

  /* ============================================
     Feature Grid
     ============================================ */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .feature-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(6, 214, 160, 0.3);
    transform: translateY(-4px);
  }

  .feature-card h3 {
    font-size: 1.125rem;
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .feature-card p {
    font-size: 0.95rem;
    margin: 0;
  }

  /* ============================================
     Results Grid
     ============================================ */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .result-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .metric {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent-turquoise);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .metric-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* ============================================
     Sidebar
     ============================================ */
  .sidebar {
    position: sticky;
    top: var(--spacing-md);
    height: fit-content;
  }

  .sidebar-section {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    margin-bottom: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-section h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .details-list {
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .details-list dt {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
  }

  .details-list dd {
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .related-links {
    list-style: none;
    padding: 0;
  }

  .related-links li {
    margin-bottom: 0.75rem;
  }

  .related-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  .related-links a:hover {
    color: var(--color-accent-turquoise);
  }

  .related-links a::before {
    content: '→ ';
    color: var(--color-accent-turquoise);
  }

  /* ============================================
     Case Navigation
     ============================================ */
  .case-nav {
    padding: var(--spacing-lg) 0;
    background: var(--color-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-body);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    padding: var(--spacing-sm);
    border-radius: 4px;
  }

  .nav-link:hover {
    color: var(--color-accent-turquoise);
    background: rgba(6, 214, 160, 0.05);
  }

  .nav-link.prev {
    text-align: left;
  }

  .nav-link.next {
    text-align: right;
    justify-self: end;
  }

  .nav-link.center {
    text-align: center;
    font-weight: 600;
  }

  .nav-label {
    display: block;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
    opacity: 0.7;
  }

  .nav-title {
    display: block;
    font-size: 1rem;
    font-weight: 600;
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 1024px) {
    .content-section .container {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      max-width: 600px;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .nav-link.prev,
    .nav-link.next {
      text-align: center;
      justify-self: stretch;
    }

    .feature-grid,
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================
     Focus Styles
     ============================================ */
  a:focus-visible {
    outline: 2px solid var(--color-accent-turquoise);
    outline-offset: 4px;
  }
</style>
