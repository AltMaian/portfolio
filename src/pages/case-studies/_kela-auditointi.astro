---
// src/pages/case-studies/kela-auditointi.astro
import Layout from '../../layouts/Layout.astro';

const caseStudy = {
  title: "Kela.fi saavutettavuusauditointi",
  subtitle: "Miten kriittinen julkinen palvelu toimii oikeille ihmisille oikeissa tilanteissa?",
  date: "[Lisää päivämäärä]",
  category: "Saavutettavuus",
  tags: ["WCAG", "Julkiset palvelut", "Auditointi"],
  readTime: "[Lisää lukuaika]"
};
---

<Layout title={`${caseStudy.title} | altmaian.dev`}>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Etusivu</a>
          <span class="separator">→</span>
          <a href="/case-studies">Case Studies</a>
          <span class="separator">→</span>
          <span class="current">{caseStudy.title}</span>
        </div>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">{caseStudy.readTime}</span>
          </div>

          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>

          <div class="tags">
            {caseStudy.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <article class="content-section">
      <div class="container">
        <div class="article-content">
          
          <!-- OHJE: Poista tämä osio kun täytät oikeilla tiedoilla -->
          <section class="instructions-box">
            <h2>📋 OHJEET AUDITOINNIN TEKEMISEEN</h2>
            <p><strong>POISTA TÄMÄ OSIO ENNEN JULKAISUA!</strong></p>
            
            <h3>Vaihe 1: Valmistautuminen (30 min)</h3>
            <ol>
              <li><strong>Asenna työkalut:</strong>
                <ul>
                  <li>Chrome: axe DevTools -laajennus (ilmainen)</li>
                  <li>NVDA ruudunlukija (ilmainen, Windows) TAI VoiceOver (Mac, sisäänrakennettu)</li>
                  <li>WAVE-laajennus selaimeen</li>
                </ul>
              </li>
              <li><strong>Luo dokumenttipohja:</strong>
                <ul>
                  <li>Avaa Google Docs / Notion</li>
                  <li>Luo otsikot: Tekninen tarkastus, Ruudunlukijatestaus, Kognitiivinen arvio</li>
                </ul>
              </li>
              <li><strong>Valitse testattavat sivut:</strong>
                <ul>
                  <li>Kela.fi etusivu</li>
                  <li>Lapsilisähakemus (tai muu lomake)</li>
                  <li>Kirjautumissivu</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 2: Tekninen WCAG-tarkastus (1-2h)</h3>
            <ol>
              <li><strong>Mene Kela.fi:hin</strong></li>
              <li><strong>Avaa axe DevTools (F12 → axe tab)</strong></li>
              <li><strong>Klikkaa "Scan All of My Page"</strong></li>
              <li><strong>Dokumentoi löydökset:</strong>
                <ul>
                  <li>Critical: Kuinka monta? Mitä? (esim. puuttuvat alt-tekstit)</li>
                  <li>Serious: Kuinka monta? Mitä? (esim. värikontrastit)</li>
                  <li>Moderate: Listaa tärkeimmät</li>
                </ul>
              </li>
              <li><strong>Testaa keyboard-navigaatio:</strong>
                <ul>
                  <li>Tab-näppäimellä läpi sivun - toimiiko loogisesti?</li>
                  <li>Näkyykö focus-indikaattori selkeästi?</li>
                  <li>Pääsetkö kaikkiin nappeihin/linkkeihin?</li>
                </ul>
              </li>
              <li><strong>Testaa zoom 200%:</strong>
                <ul>
                  <li>Ctrl/Cmd + (zoomaa 200%)</li>
                  <li>Rikkoutuuko layout?</li>
                  <li>Pysyykö teksti luettavana?</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 3: Ruudunlukijatestaus (1-2h)</h3>
            <ol>
              <li><strong>Käynnistä NVDA (Windows) tai VoiceOver (Mac):</strong>
                <ul>
                  <li>NVDA: Lataa nvaccess.org, asenna, käynnistä Ctrl+Alt+N</li>
                  <li>VoiceOver: Cmd+F5 (Mac)</li>
                </ul>
              </li>
              <li><strong>NVDA-perusteet:</strong>
                <ul>
                  <li>Insert+Down = lue kaikki</li>
                  <li>H = seuraava otsikko</li>
                  <li>K = seuraava linkki</li>
                  <li>B = seuraava nappi</li>
                  <li>F = seuraava lomakekenttä</li>
                </ul>
              </li>
              <li><strong>Testaa Kela.fi:ssä:</strong>
                <ul>
                  <li>Pääsetkö päänavigaatioon helposti?</li>
                  <li>Lukeeko ruudunlukija linkit ja napit selkeästi?</li>
                  <li>Kertooko lomakekentät mitä niihin pitää täyttää?</li>
                  <li>Ilmoittaako virheet selkeästi?</li>
                </ul>
              </li>
              <li><strong>Dokumentoi ongelmat:</strong>
                <ul>
                  <li>"Nappi lukee vain 'Klikkaa tästä' - ei kerro minne menee"</li>
                  <li>"Virheviesti ei liity kenttään - en tiedä mikä on väärin"</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 4: Kognitiivinen arviointi (1h)</h3>
            <p><strong>Simuloi todellista käyttötilannetta:</strong></p>
            <ol>
              <li><strong>Tee lomake iltaisin (klo 21-23):</strong>
                <ul>
                  <li>Oletko väsyneempi? Huomaatko virheitä hitaammin?</li>
                </ul>
              </li>
              <li><strong>Tee lomake puhelimella:</strong>
                <ul>
                  <li>Toimiiko kosketusnäytöllä?</li>
                  <li>Ovatko napit tarpeeksi isoja?</li>
                </ul>
              </li>
              <li><strong>Keskeytä itsesi tarkoituksella:</strong>
                <ul>
                  <li>Täytä lomaketta 5 min → sulje välilehti → avaa uudelleen</li>
                  <li>Säilyikö tieto? Pääsetkö jatkamaan?</li>
                </ul>
              </li>
              <li><strong>Dokumentoi:</strong>
                <ul>
                  <li>Miten palvelu reagoi keskeytyksiin?</li>
                  <li>Aiheuttaako jotain turhaa stressiä?</li>
                  <li>Onko selvää missä kohtaa olet lomakkeessa?</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 5: Analysoi ja kirjoita (2-3h)</h3>
            <ol>
              <li><strong>Ryhmittele havainnot:</strong>
                <ul>
                  <li>Kriittiset ongelmat (estävät käytön)</li>
                  <li>Merkittävät ongelmat (vaikeuttavat käyttöä)</li>
                  <li>Pienet ongelmat (ärsyttävät mutta eivät estä)</li>
                </ul>
              </li>
              <li><strong>Priorisoi suositukset:</strong>
                <ul>
                  <li>Mitä TÄYTYY korjata heti?</li>
                  <li>Mitä pitäisi korjata pian?</li>
                  <li>Mitä olisi mukava korjata?</li>
                </ul>
              </li>
              <li><strong>Täytä tämä pohja:</strong>
                <ul>
                  <li>Korvaa [TÄYTÄ TÄHÄN] -kohdat omilla havainnoillasi</li>
                  <li>Lisää kuvakaappauksia ongelmista (blur arkaluontoiset tiedot!)</li>
                  <li>Kirjoita omin sanoin - älä kopioi esimerkkejä</li>
                </ul>
              </li>
            </ol>

            <h3>💡 Vinkit:</h3>
            <ul>
              <li>Ole rehellinen - dokumentoi mitä OIKEASTI löysit, ei mitä luulet pitävän löytää</li>
              <li>Ota kuvakaappauksia ongelmista (blur henkilökohtaiset tiedot!)</li>
              <li>Testaa OIKEASTI ruudunlukijalla - älä oleta miten se toimii</li>
              <li>Keskity käytettävyyteen, ei vain tekniseen complianceen</li>
              <li>Jos et löydä ongelmia - se on OK! Dokumentoi mitä toimii hyvin</li>
            </ul>

            <h3>⚠️ Tärkeää:</h3>
            <ul>
              <li><strong>ÄLÄ julkaise ennen kuin olet tehnyt oikean auditoinnin</strong></li>
              <li><strong>ÄLÄ käytä keksittyjä esimerkkejä</strong></li>
              <li><strong>POISTA nämä ohjeet ennen julkaisua</strong></li>
              <li>Lisää disclaimer: "Tämä on henkilökohtainen analyysi, ei Kelan virallinen kanta"</li>
            </ul>
          </section>
          <!-- OHJEIDEN LOPPU -->

          <!-- Summary -->
          <section class="section">
            <h2>Yhteenveto</h2>
            <div class="summary-box">
              <p>
                [TÄYTÄ TÄHÄN: Lyhyt yhteenveto (3-4 lausetta) mitä teit ja mitä löysit. 
                Esim: "Tarkastelin Kela.fi-palvelua kolmesta näkökulmasta: tekninen WCAG-tarkastus, 
                ruudunlukijatestaus, ja kognitiivinen kuormitus. Löysin X kriittistä ongelmaa ja 
                Y merkittävää puutetta saavutettavuudessa."]
              </p>
            </div>
          </section>

          <!-- Context -->
          <section class="section">
            <h2>Konteksti</h2>
            <p>
              [TÄYTÄ TÄHÄN: Miksi valitsit Kela.fi:n? Miksi se on tärkeä? 
              Mitä palveluita testasit (lapsilisä, asumistuki, yms)?]
            </p>
          </section>

          <!-- Methodology -->
          <section class="section">
            <h2>Auditointimenetelmä</h2>
            <p>
              [TÄYTÄ TÄHÄN: Miten teit auditoinnin? Mitä työkaluja käytit? 
              Kuinka kauan aikaa meni?]
            </p>
            
            <div class="feature-grid">
              <div class="feature-card">
                <h3>1. Tekninen tarkastus</h3>
                <p>
                  [TÄYTÄ: Mitä työkaluja käytit? axe DevTools? WAVE? Lighthouse?
                  Mitä testasit?]
                </p>
              </div>

              <div class="feature-card">
                <h3>2. Ruudunlukijatestaus</h3>
                <p>
                  [TÄYTÄ: Käytitkö NVDA vai VoiceOveria? Minkä sivun testasit?
                  Miten kauan testasit?]
                </p>
              </div>

              <div class="feature-card">
                <h3>3. Kognitiivinen kuormitus</h3>
                <p>
                  [TÄYTÄ: Miten testasit? Teitkö lomaketta väsyneenä? 
                  Keskeytitkö itsesi? Mitä havaitsi?]
                </p>
              </div>
            </div>
          </section>

          <!-- Findings -->
          <section class="section">
            <h2>Keskeiset havainnot</h2>

            <h3>✅ Mikä toimii hyvin</h3>
            <div class="learnings-box">
              <p>[TÄYTÄ TÄHÄN: Lista asioista jotka toimivat hyvin. Ole rehellinen!]</p>
              <ul>
                <li>[Esim: Värikontrastit olivat hyvät]</li>
                <li>[Esim: Navigaatio oli selkeä]</li>
                <li>[Lisää lisää...]</li>
              </ul>
            </div>

            <h3>⚠️ Ongelmat</h3>
            
            <div class="problem-section">
              <h4>[TÄYTÄ: Ongelman otsikko]</h4>
              <p>
                [TÄYTÄ: Mitä ongelmaa havaitsi? Ole spesifinen. Esim: 
                "Lomakkeen kenttä 'Henkilötunnus' ei kertonut ruudunlukijalle että se on pakollinen"]
              </p>
              <p><strong>Vaikutus:</strong> [TÄYTÄ: Kriittinen/Suuri/Keskisuuri/Pieni]</p>
              <p><strong>WCAG-kriteeri:</strong> [TÄYTÄ: Esim. 3.3.2 Labels or Instructions (Level A)]</p>
            </div>

            <div class="problem-section">
              <h4>[TÄYTÄ: Toinen ongelma]</h4>
              <p>[TÄYTÄ: Kuvaus]</p>
              <p><strong>Vaikutus:</strong> [TÄYTÄ]</p>
              <p><strong>WCAG-kriteeri:</strong> [TÄYTÄ]</p>
            </div>

            <p>[LISÄÄ LISÄÄ ONGELMIA TARPEEN MUKAAN - kopioi problem-section]</p>
          </section>

          <!-- Recommendations -->
          <section class="section">
            <h2>Suositukset</h2>
            <p>
              [TÄYTÄ TÄHÄN: Lyhyt johdanto suosituksiin. Miten priorisoiti?]
            </p>

            <h3>🔥 Kriittiset (korjattava heti)</h3>
            <div class="feature-grid">
              <div class="feature-card priority-critical">
                <h3>[TÄYTÄ: Suosituksen otsikko]</h3>
                <p>
                  [TÄYTÄ: Mitä pitäisi tehdä? Ole konkreettinen. 
                  Esim: "Lisää aria-required="true" kaikkiin pakollisiin kenttiin"]
                </p>
                <p class="implementation">Toteutus: [Helppo/Keskivaikea/Vaikea]</p>
              </div>

              <p>[LISÄÄ LISÄÄ KRIITTISIÄ SUOSITUKSIA]</p>
            </div>

            <h3>⚡ Tärkeät (korjattava pian)</h3>
            <div class="feature-grid">
              <div class="feature-card priority-high">
                <h3>[TÄYTÄ: Suosituksen otsikko]</h3>
                <p>[TÄYTÄ: Kuvaus]</p>
                <p class="implementation">Toteutus: [Arvio]</p>
              </div>

              <p>[LISÄÄ LISÄÄ TÄRKEITÄ SUOSITUKSIA]</p>
            </div>

            <h3>💡 Hyvä olisi (jos aikaa)</h3>
            <ul>
              <li>[TÄYTÄ: Lisäparannuksia]</li>
              <li>[TÄYTÄ: Lisää...]</li>
            </ul>
          </section>

          <!-- Impact -->
          <section class="section">
            <h2>Arvioitu vaikutus</h2>
            <p>
              [TÄYTÄ TÄHÄN: Mitä tapahtuisi jos nämä korjattaisiin? 
              Voit joko jättää tämän osion pois, tai arvioida hyvin varovaisesti.
              ÄLÄ keksi lukuja - jos et voi arvioida, älä yritä.]
            </p>
          </section>

          <!-- Learnings -->
          <section class="section">
            <h2>Oppimia asioita</h2>
            <div class="learnings-box">
              <h3>[TÄYTÄ: Ensimmäinen oppiminen]</h3>
              <p>
                [TÄYTÄ: Mitä opit tästä prosessista? Esim: "Opin että WCAG-compliance 
                ei tarkoita hyvää käyttökokemusta"]
              </p>

              <h3>[TÄYTÄ: Toinen oppiminen]</h3>
              <p>[TÄYTÄ: Kuvaus]</p>

              <p>[LISÄÄ LISÄÄ OPPIMISIA]</p>
            </div>
          </section>

          <!-- Conclusion -->
          <section class="section">
            <h2>Johtopäätökset</h2>
            <p>
              [TÄYTÄ TÄHÄN: Loppuyhteenveto. Mitä haluat lukijan muistavan? 
              3-5 kappaletta omia ajatuksiasi.]
            </p>
          </section>

          <!-- Disclaimer -->
          <section class="section">
            <div class="disclaimer-box">
              <p>
                <strong>Huomautus:</strong> Tämä auditointi on henkilökohtainen analyysi 
                ja ei edusta Kelan virallista kantaa. Havainnot perustuvat [TÄYTÄ PÄIVÄMÄÄRÄ] 
                versioon palvelusta. Kela saattaa olla jo korjannut joitain näistä ongelmista.
              </p>
            </div>
          </section>

        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3>Auditointitiedot</h3>
            <dl class="details-list">
              <dt>Palvelu</dt>
              <dd>[TÄYTÄ: Esim. Kela.fi (Lapsilisähakemus)]</dd>
              
              <dt>Päivämäärä</dt>
              <dd>[TÄYTÄ PÄIVÄMÄÄRÄ]</dd>
              
              <dt>Menetelmät</dt>
              <dd>[TÄYTÄ: Esim. WCAG 2.1 AA, NVDA-testaus]</dd>
              
              <dt>Työkalut</dt>
              <dd>[TÄYTÄ: Esim. axe DevTools, NVDA]</dd>
              
              <dt>Kesto</dt>
              <dd>[TÄYTÄ: Esim. 6 tuntia]</dd>
            </dl>
          </div>

          <div class="sidebar-section">
            <h3>Liittyvät artikkelit</h3>
            <ul class="related-links">
              <li><a href="#">[Linkki toiseen case studyyn]</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </article>

    <!-- Navigation -->
    <section class="case-nav">
      <div class="container">
        <div class="nav-links">
          <a href="#" class="nav-link prev">
            <span class="nav-label">Edellinen</span>
            <span class="nav-title">[Case study]</span>
          </a>
          <a href="/case-studies" class="nav-link center">
            Kaikki case studyt
          </a>
          <a href="#" class="nav-link next">
            <span class="nav-label">Seuraava</span>
            <span class="nav-title">[Case study]</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables
     ============================================ */
  :root {
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --color-warning: #fbbf24;
    --color-critical: #ef4444;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --font-display: 'Space Mono', monospace;
    --font-body: 'JetBrains Mono', monospace;
  }

  main {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* Instructions box - REMOVE BEFORE PUBLISHING */
  .instructions-box {
    background: #fef3c7;
    border: 4px solid #f59e0b;
    color: #78350f;
    padding: var(--spacing-md);
    border-radius: 8px;
    margin-bottom: var(--spacing-lg);
  }

  .instructions-box h2 {
    color: #92400e !important;
    margin-bottom: var(--spacing-sm);
    font-size: 1.5rem;
  }

  .instructions-box h3 {
    color: #92400e !important;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    font-size: 1.125rem;
  }

  .instructions-box p,
  .instructions-box li {
    color: #78350f !important;
  }

  .instructions-box strong {
    color: #92400e !important;
  }

  .instructions-box ol,
  .instructions-box ul {
    margin-top: 0.5rem;
    margin-bottom: var(--spacing-sm);
  }

  /* Hero */
  .hero {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-turquoise);
  }

  .breadcrumb .separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .meta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .category {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .date,
  .read-time {
    color: var(--color-text-muted);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  /* Content Section */
  .content-section {
    padding: var(--spacing-lg) 0;
  }

  .content-section .container {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--spacing-lg);
  }

  .article-content {
    max-width: 800px;
  }

  /* Typography */
  .section {
    margin-bottom: var(--spacing-lg);
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-accent-turquoise);
  }

  .section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .section h4 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-purple);
  }

  .section p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .section ul,
  .section ol {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .section li {
    margin-bottom: 0.5rem;
  }

  .section strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .section em {
    color: var(--color-accent-turquoise);
