---
// src/pages/case-studies/nordea-mobiili-auditointi.astro
import Layout from '../../layouts/Layout.astro';

const caseStudy = {
  title: "Nordea-mobiilisovelluksen saavutettavuusauditointi",
  subtitle: "Miten pankkiasiointi toimii kiireessä, stressaantuneena, ja TalkBack-ruudunlukijalla?",
  date: "[Lisää päivämäärä]",
  category: "Mobiilisaavutettavuus",
  tags: ["Android", "TalkBack", "Mobiili", "Käytettävyys"],
  readTime: "[Lisää lukuaika]"
};
---

<Layout title={`${caseStudy.title} | altmaian.dev`}>
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="breadcrumb">
          <a href="/">Etusivu</a>
          <span class="separator">→</span>
          <a href="/case-studies">Case Studies</a>
          <span class="separator">→</span>
          <span class="current">{caseStudy.title}</span>
        </div>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">{caseStudy.readTime}</span>
          </div>

          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>

          <div class="tags">
            {caseStudy.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <article class="content-section">
      <div class="container">
        <div class="article-content">
          
          <!-- OHJE: Poista tämä osio kun täytät oikeilla tiedoilla -->
          <section class="instructions-box">
            <h2>📱 OHJEET MOBIILIAUDITOINNIN TEKEMISEEN</h2>
            <p><strong>POISTA TÄMÄ OSIO ENNEN JULKAISUA!</strong></p>
            
            <h3>Vaihe 1: Valmistautuminen (30 min)</h3>
            <ol>
              <li><strong>Asenna työkalut Android-puhelimeesi:</strong>
                <ul>
                  <li>Nordea-mobiilisovellus (jos et ole jo asentanut)</li>
                  <li>Accessibility Scanner (Google Play: "Accessibility Scanner")</li>
                  <li>Ota TalkBack käyttöön (Asetukset → Saavutettavuus → TalkBack)</li>
                </ul>
              </li>
              <li><strong>Luo dokumenttipohja:</strong>
                <ul>
                  <li>Google Docs / Notion tietokoneella</li>
                  <li>Otsikot: TalkBack-testaus, Accessibility Scanner, Käytettävyystestaus, Stressitestaus</li>
                </ul>
              </li>
              <li><strong>Valmistele kuvakaappaukset:</strong>
                <ul>
                  <li>Ota kuvakaappauksia ongelmista (Volyymi alas + Virta -painike)</li>
                  <li>MUISTA: Blur kaikki henkilökohtaiset tiedot (tilinumerot, saldot, nimet)!</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 2: TalkBack-ruudunlukijatestaus (2-3h)</h3>
            <ol>
              <li><strong>Ota TalkBack käyttöön:</strong>
                <ul>
                  <li>Asetukset → Saavutettavuus → TalkBack → Päällä</li>
                  <li>Käy läpi opastus (TalkBack opettaa peruskäytön)</li>
                </ul>
              </li>
              
              <li><strong>TalkBack-perusteet (TÄRKEÄÄ!):</strong>
                <ul>
                  <li><strong>Pyyhkäise oikealle</strong> = seuraava elementti</li>
                  <li><strong>Pyyhkäise vasemmalle</strong> = edellinen elementti</li>
                  <li><strong>Kaksoisnapauta</strong> = aktivoi elementti</li>
                  <li><strong>Kaksi sormea pyyhkäisy ylös/alas</strong> = skrollaa sivua</li>
                  <li><strong>Kaksi sormea napauta</strong> = keskeytä puhe</li>
                  <li><strong>Sulje TalkBack</strong> = Volyymi ylös + alas 3 sekuntia</li>
                </ul>
              </li>

              <li><strong>Testaa Nordea-sovelluksessa:</strong>
                <ul>
                  <li><strong>Kirjautuminen:</strong>
                    <ul>
                      <li>Avaa Nordea-sovellus TalkBackilla päällä</li>
                      <li>Navigoi kirjautumisruutuun</li>
                      <li>Lukeeko TalkBack selkeästi mitä kenttiä on?</li>
                      <li>Kertooko "Tunnusluku" vs "Salasana" vai vain "Tekstikenttä"?</li>
                      <li>Onnistuuko kirjautuminen pelkällä TalkBackilla?</li>
                    </ul>
                  </li>
                  
                  <li><strong>Päänäkymä:</strong>
                    <ul>
                      <li>Kun kirjauduit sisään, kuinka helppo navigoida?</li>
                      <li>Löydätkö tilien saldot TalkBackilla?</li>
                      <li>Kertooko TalkBack saldot selkeästi?</li>
                      <li>Pääsetkö helposti "Tee maksu" -toimintoon?</li>
                    </ul>
                  </li>

                  <li><strong>Tilisiirto:</strong>
                    <ul>
                      <li>Yritä tehdä tilisiirto TalkBackilla (ÄLÄ lähetä oikeasti!)</li>
                      <li>Onko kentät selkeästi nimettyjä?</li>
                      <li>Kertooko virheviestit mitä on väärin?</li>
                      <li>Löydätkö "Lähetä" -napin helposti?</li>
                    </ul>
                  </li>

                  <li><strong>Navigaatio:</strong>
                    <ul>
                      <li>Kuinka helposti navigoit välilehdeltä toiselle?</li>
                      <li>Onko päävalikko looginen TalkBackilla?</li>
                      <li>Lukeeko kaikki napit selkeästi mitä ne tekevät?</li>
                    </ul>
                  </li>
                </ul>
              </li>

              <li><strong>Dokumentoi ongelmat:</strong>
                <ul>
                  <li>"Nappi lukee vain 'Nappi' - ei kerro mitä se tekee"</li>
                  <li>"Saldo lukee '1234.56' - ei kerro että kyse on euroista"</li>
                  <li>"Virheviesti 'Tarkista syöte' - ei kerro mikä kenttä on väärin"</li>
                  <li>"Tab-valikko ei kerro missä välilehdessä olen"</li>
                </ul>
              </li>

              <li><strong>⚠️ MUISTA:</strong>
                <ul>
                  <li>ÄLÄ tee oikeita maksuja testauksen aikana!</li>
                  <li>Blur kaikki henkilökohtaiset tiedot kuvakaappauksista</li>
                  <li>Testaa 1-2 tuntia kerrallaan - TalkBack on uuvuttava jos et ole tottunut</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 3: Accessibility Scanner (30 min)</h3>
            <ol>
              <li><strong>Käynnistä Accessibility Scanner:</strong>
                <ul>
                  <li>Asetukset → Saavutettavuus → Accessibility Scanner → Päällä</li>
                  <li>Näytölle ilmestyy sininen kelluke-nappi</li>
                </ul>
              </li>

              <li><strong>Skannaa Nordea-sovellus:</strong>
                <ul>
                  <li>Avaa Nordea</li>
                  <li>Paina kelluke-nappia (sininen ympyrä)</li>
                  <li>Valitse "Scan screen" / "Skannaa näyttö"</li>
                  <li>Scanner näyttää ongelmat oranssilla kehyksellä</li>
                </ul>
              </li>

              <li><strong>Dokumentoi löydökset:</strong>
                <ul>
                  <li>Kuinka monta ongelmaa per näyttö?</li>
                  <li>Mitä ongelmia? (esim. "Kosketusalue liian pieni")</li>
                  <li>Mitkä näytöt olivat pahimpia?</li>
                  <li>Ota kuvakaappaukset Scannerin löydöksistä</li>
                </ul>
              </li>

              <li><strong>Tyypilliset ongelmat mitä Scanner löytää:</strong>
                <ul>
                  <li>"Kosketusalue alle 48x48 dp" (nappi liian pieni)</li>
                  <li>"Tekstikontrasti alle 4.5:1" (vaikea lukea)</li>
                  <li>"Ei sisältökuvausta" (kuva ilman alt-tekstiä)</li>
                  <li>"Päällekkäiset klikkialueet" (napit liian lähellä)</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 4: Käytettävyystestaus oikeissa tilanteissa (1-2h)</h3>
            <p><strong>Simuloi todellisia käyttötilanteita:</strong></p>
            
            <ol>
              <li><strong>Yhdellä kädellä testaus (bussi/metro):</strong>
                <ul>
                  <li>Pidä puhelinta vain yhdessä kädessä</li>
                  <li>Yritä kirjautua sisään peukalolla</li>
                  <li>Tee tilisiirto yhdellä kädellä</li>
                  <li>Onko napit tarpeeksi isoja? Liian lähellä toisiaan?</li>
                  <li>Dokumentoi: "Kirjaudu-nappi reunassa, vaikea osua peukalolla"</li>
                </ul>
              </li>

              <li><strong>Auringonvalossa (ulkona päivällä):</strong>
                <ul>
                  <li>Mene ulos kirkkaassa auringonpaisteessa</li>
                  <li>Avaa Nordea</li>
                  <li>Näetkö tekstit? Saldot? Napit?</li>
                  <li>Ovatko kontrastit riittävät?</li>
                  <li>Dokumentoi: "Harmaa teksti valkoisella - ei näy auringossa"</li>
                </ul>
              </li>

              <li><strong>Kävellessä (hajamielinen):</strong>
                <ul>
                  <li>Kävele samalla kun käytät sovellusta (TURVALLISESTI!)</li>
                  <li>Kuinka helppo keskittyä?</li>
                  <li>Onko tärkeät asiat isosti ja selkeästi?</li>
                  <li>Dokumentoi: "Liian pientä tekstiä, vaikea lukea kävellessä"</li>
                </ul>
              </li>

              <li><strong>Stressaantuneena (väsynyt ilta):</strong>
                <ul>
                  <li>Testaa iltaisin kun olet väsynyt (klo 21-23)</li>
                  <li>Yritä tehdä tilisiirto nopeasti</li>
                  <li>Onko prosessi selkeä vai hämmentävä?</li>
                  <li>Teetkö virheitä helpommin?</li>
                  <li>Dokumentoi: "Vahvistusruutu epäselvä - melkein lähetin väärän summan"</li>
                </ul>
              </li>

              <li><strong>Huonolla netillä (Lentotila ON/OFF):</strong>
                <ul>
                  <li>Laita lentotila päälle 5 sekunniksi → pois päältä</li>
                  <li>Simuloi nettikatkoa</li>
                  <li>Miten sovellus reagoi?</li>
                  <li>Kertooko selkeästi että netti katkes?</li>
                  <li>Säilyikö tiedot vai katosiko?</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 5: Visuaalinen tarkastus (30 min)</h3>
            <ol>
              <li><strong>Fonttikoko ja skaalautuminen:</strong>
                <ul>
                  <li>Asetukset → Näyttö → Fonttikoko → Suuri / Erittäin suuri</li>
                  <li>Avaa Nordea</li>
                  <li>Skaalautuuko teksti oikein?</li>
                  <li>Menevätkö tekstit päällekkäin?</li>
                  <li>Dokumentoi: "Suuri fontti rikkoo layoutin - nappi katkeaa"</li>
                </ul>
              </li>

              <li><strong>Värikontrasti (visuaalinen arvio):</strong>
                <ul>
                  <li>Onko teksti hyvin luettavaa?</li>
                  <li>Harmaa teksti valkoisella taustalla - toimiiko?</li>
                  <li>Linkit - erottuvatko selkeästi?</li>
                  <li>(Huom: et voi mitata kontrasti numerolla mobiilissa, mutta voit arvioida)</li>
                </ul>
              </li>

              <li><strong>Kosketusnäppäimet:</strong>
                <ul>
                  <li>Ovatko napit riittävän isoja? (vähintään n. 1cm x 1cm)</li>
                  <li>Onko nappien välissä tilaa? (ei vahinkopainalluksia)</li>
                  <li>Voitko osua nappiin helposti?</li>
                </ul>
              </li>
            </ol>

            <h3>Vaihe 6: Analysoi ja kirjoita (2-3h)</h3>
            <ol>
              <li><strong>Ryhmittele havainnot:</strong>
                <ul>
                  <li>TalkBack-ongelmat (esim. napit ilman nimiä)</li>
                  <li>Accessibility Scanner -löydökset (esim. liian pienet napit)</li>
                  <li>Käytettävyysongelmat (esim. vaikea käyttää yhdellä kädellä)</li>
                  <li>Visuaaliset ongelmat (esim. huono kontrasti)</li>
                </ul>
              </li>

              <li><strong>Priorisoi:</strong>
                <ul>
                  <li>Kriittiset: Estävät TalkBack-käyttäjää kokonaan</li>
                  <li>Merkittävät: Vaikeuttavat huomattavasti käyttöä</li>
                  <li>Pienet: Ärsyttävät mutta eivät estä</li>
                </ul>
              </li>

              <li><strong>Täytä tämä pohja:</strong>
                <ul>
                  <li>Korvaa [TÄYTÄ TÄHÄN] -kohdat</li>
                  <li>Lisää kuvakaappauksia (blur henkilökohtaiset tiedot!)</li>
                  <li>Kirjoita omin sanoin</li>
                  <li>Ole rehellinen - dokumentoi vain mitä LÖYSIT</li>
                </ul>
              </li>
            </ol>

            <h3>💡 Vinkit:</h3>
            <ul>
              <li><strong>TalkBack on uuvuttavaa</strong> - testaa 30-60 min kerrallaan, pidä taukoja</li>
              <li><strong>Älä arvaile</strong> - jos et löydä ongelmaa, se on OK!</li>
              <li><strong>Blur KAIKKI henkilökohtaiset tiedot</strong> kuvakaappauksista</li>
              <li><strong>Testaa oikeasti</strong> - älä oleta miten TalkBack toimii</li>
              <li><strong>Dokumentoi hyvin toimivat asiat</strong> - ei pelkästään ongelmia</li>
              <li><strong>Keskity käyttökokemukseen</strong> ei tekniseen koodiin (sitä et näe)</li>
            </ul>

            <h3>⚠️ Tärkeää - Mobiiliauditoinnin rajoitukset:</h3>
            <ul>
              <li>Et pääse sovelluksen koodiin → et voi tarkistaa aria-attribuutteja</li>
              <li>Et voi käyttää axe DevTools tai WAVE → rajallisemmat työkalut</li>
              <li>Sovellus voi päivittyä → havaintosi saattavat vanhentua</li>
              <li>Keskity käyttäjäkokemukseen, ei tekniseen WCAG-complianceen</li>
            </ul>

            <h3>📸 Kuvakaappausten blur-ohjeet:</h3>
            <ol>
              <li>Ota kuvakaappaus (Volyymi alas + Virta)</li>
              <li>Avaa Galleria / Kuvat</li>
              <li>Muokkaa → Piirto / Markup</li>
              <li>Piirrä paksulla pensselillä yli:
                <ul>
                  <li>Tilinumerot</li>
                  <li>Saldot</li>
                  <li>Nimet</li>
                  <li>Henkilötunnukset</li>
                  <li>Osoitteet</li>
                </ul>
              </li>
              <li>Tallenna blurrattu versio</li>
            </ol>

            <h3>🚫 MUISTA:</h3>
            <ul>
              <li><strong>ÄLÄ julkaise ennen kuin olet tehnyt oikean auditoinnin</strong></li>
              <li><strong>ÄLÄ käytä keksittyjä esimerkkejä</strong></li>
              <li><strong>ÄLÄ tee oikeita maksuja testauksen aikana</strong></li>
              <li><strong>BLUR kaikki henkilökohtaiset tiedot kuvakaappauksista</strong></li>
              <li><strong>POISTA nämä ohjeet ennen julkaisua</strong></li>
              <li>Lisää disclaimer: "Henkilökohtainen analyysi, ei Nordean virallinen kanta"</li>
            </ul>
          </section>
          <!-- OHJEIDEN LOPPU -->

          <!-- Summary -->
          <section class="section">
            <h2>Yhteenveto</h2>
            <div class="summary-box">
              <p>
                [TÄYTÄ TÄHÄN: Lyhyt yhteenveto (3-4 lausetta). Esim: "Testasin Nordea-mobiilisovellusta 
                (Android) TalkBack-ruudunlukijalla, Accessibility Scannerilla, ja erilaisissa 
                käyttötilanteissa. Löysin X kriittistä TalkBack-ongelmaa ja Y käytettävyysongelmaa."]
              </p>
            </div>
          </section>

          <!-- Context -->
          <section class="section">
            <h2>Konteksti</h2>
            <p>
              [TÄYTÄ TÄHÄN: Miksi valitsit Nordea-mobiilisovelluksen? Miksi se on tärkeä? 
              Mitä toimintoja testasit (kirjautuminen, tilisiirto, saldot)?]
            </p>
            <p>
              [TÄYTÄ: Mikä Android-versio? Mikä puhelinmalli? Sovelluksen versio?
              Esim: "Samsung Galaxy S21, Android 13, Nordea Mobile v10.5.2"]
            </p>
          </section>

          <!-- Methodology -->
          <section class="section">
            <h2>Testausmenetelmä</h2>
            <p>
              [TÄYTÄ TÄHÄN: Miten testasit? Kuinka kauan? Mitä työkaluja käytit?]
            </p>
            
            <div class="feature-grid">
              <div class="feature-card">
                <h3>1. TalkBack-testaus</h3>
                <p>
                  [TÄYTÄ: Kuinka kauan testasit TalkBackilla? Mitä toimintoja testasit?
                  Oliko tämä ensimmäinen kerta TalkBackin käytössä?]
                </p>
              </div>

              <div class="feature-card">
                <h3>2. Accessibility Scanner</h3>
                <p>
                  [TÄYTÄ: Montako näyttöä skannasit? Kuinka monta ongelmaa löytyi
                  keskimäärin per näyttö?]
                </p>
              </div>

              <div class="feature-card">
                <h3>3. Käytettävyystestaus</h3>
                <p>
                  [TÄYTÄ: Missä tilanteissa testasit? Yhdellä kädellä? Auringonvalossa?
                  Kävellessä? Väsyneenä?]
                </p>
              </div>
            </div>
          </section>

          <!-- Findings -->
          <section class="section">
            <h2>Keskeiset havainnot</h2>

            <h3>✅ Mikä toimii hyvin</h3>
            <div class="learnings-box">
              <p>[TÄYTÄ TÄHÄN: Positiiviset havainnot. Ole rehellinen!]</p>
              <ul>
                <li>[Esim: TalkBack luki saldot selkeästi]</li>
                <li>[Esim: Kirjautumisnapit olivat isoja ja helposti osuttavia]</li>
                <li>[Lisää...]</li>
              </ul>
            </div>

            <h3>⚠️ TalkBack-ongelmat</h3>
            
            <div class="problem-section">
              <h4>[TÄYTÄ: TalkBack-ongelman otsikko]</h4>
              <p>
                [TÄYTÄ: Mitä TalkBack-ongelmaa havaitsi? Ole spesifinen. 
                Esim: "Tilisiirto-nappi lukee vain 'Nappi' - ei kerro että se tekee tilisiirron"]
              </p>
              <p><strong>Vaikutus:</strong> [Kriittinen/Suuri/Keskisuuri - näkövammainen käyttäjä]</p>
              <p><strong>Missä:</strong> [Esim: Etusivu, Tilisiirtonäkymä]</p>
            </div>

            <div class="problem-section">
              <h4>[TÄYTÄ: Toinen TalkBack-ongelma]</h4>
              <p>[TÄYTÄ: Kuvaus]</p>
              <p><strong>Vaikutus:</strong> [TÄYTÄ]</p>
              <p><strong>Missä:</strong> [TÄYTÄ]</p>
            </div>

            <h3>⚠️ Accessibility Scanner -löydökset</h3>
            
            <div class="problem-section">
              <h4>[TÄYTÄ: Scanner-ongelman otsikko]</h4>
              <p>
                [TÄYTÄ: Mitä Scanner löysi? Esim: "Vahvista-nappi on 42x42 dp, 
                alle suositellun 48x48 dp minimikoon"]
              </p>
              <p><strong>Vaikutus:</strong> [TÄYTÄ]</p>
              <p><strong>Missä:</strong> [TÄYTÄ]</p>
            </div>

            <h3>⚠️ Käytettävyysongelmat</h3>
            
            <div class="problem-section">
              <h4>[TÄYTÄ: Käytettävyysongelman otsikko]</h4>
              <p>
                [TÄYTÄ: Mitä käytettävyysongelmaa havaitsi todellisissa tilanteissa?
                Esim: "Yhdellä kädellä käyttäessä kirjaudu-nappi oli liian kaukana peukalosta"]
              </p>
              <p><strong>Tilanne:</strong> [Esim: Yhdellä kädellä käyttö bussissa]</p>
              <p><strong>Vaikutus:</strong> [TÄYTÄ]</p>
            </div>

            <p>[LISÄÄ LISÄÄ ONGELMIA TARPEEN MUKAAN]</p>
          </section>

          <!-- Recommendations -->
          <section class="section">
            <h2>Suositukset</h2>
            <p>
              [TÄYTÄ TÄHÄN: Johdanto suosituksiin. Miten priorisoitit?]
            </p>

            <h3>🔥 Kriittiset (korjattava heti)</h3>
            <div class="feature-grid">
              <div class="feature-card priority-critical">
                <h3>[TÄYTÄ: Suosituksen otsikko]</h3>
                <p>
                  [TÄYTÄ: Mitä pitäisi tehdä? Ole konkreettinen.
                  Esim: "Lisää contentDescription kaikkiin nappeihin jotka TalkBack voi lukea"]
                </p>
                <p class="implementation">Android: [Esim: Lisää android:contentDescription XML:ään]</p>
              </div>

              <p>[LISÄÄ LISÄÄ KRIITTISIÄ SUOSITUKSIA]</p>
            </div>

            <h3>⚡ Tärkeät (korjattava pian)</h3>
            <div class="feature-grid">
              <div class="feature-card priority-high">
                <h3>[TÄYTÄ: Suosituksen otsikko]</h3>
                <p>[TÄYTÄ: Kuvaus]</p>
                <p class="implementation">[TÄYTÄ]</p>
              </div>

              <p>[LISÄÄ LISÄÄ]</p>
            </div>

            <h3>💡 Hyvä olisi</h3>
            <ul>
              <li>[TÄYTÄ: Lisäparannuksia]</li>
              <li>[TÄYTÄ: Lisää...]</li>
            </ul>
          </section>

          <!-- Learnings -->
          <section class="section">
            <h2>Oppimia asioita</h2>
            <div class="learnings-box">
              <h3>[TÄYTÄ: Ensimmäinen oppiminen]</h3>
              <p>
                [TÄYTÄ: Mitä opit? Esim: "TalkBackin käyttö on yllättävän vaikeaa - 
                ymmärrän nyt paremmin näkövammaisten haasteita"]
              </p>

              <h3>[TÄYTÄ: Toinen oppiminen]</h3>
              <p>[TÄYTÄ]</p>

              <p>[LISÄÄ LISÄÄ]</p>
            </div>
          </section>

          <!-- Conclusion -->
          <section class="section">
            <h2>Johtopäätökset</h2>
            <p>
              [TÄYTÄ TÄHÄN: Loppuyhteenveto. Mitä haluat lukijan muistavan?
              3-5 kappaletta omia ajatuksiasi mobiilisaavutettavuudesta.]
            </p>
          </section>

          <!-- Disclaimer -->
          <section class="section">
