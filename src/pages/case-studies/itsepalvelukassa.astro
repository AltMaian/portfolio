---
// src/pages/case-studies/itsepalvelukassa.astro
import Layout from '../../layouts/Layout.astro';

const img = (name: string) => `/case-studies/itsepalvelukassa/${name}`;

const caseStudy = {
  title: 'Opiskelijaravintolan maksupäätteen uudelleen\u00ADsuunnittelu',
  subtitle:
    'Miten lounaan maksamisesta saa selkeää, kun jonossa on kiire? Analysoin olemassa olevan itsepalvelukassan kognitiivisen psykologian avulla ja suunnittelin sen uudelleen paperiprototyypiksi.',
  date: 'Syksy 2026',
  category: 'Käyttöliittymäsuunnittelu',
  tags: ['Kognitiivinen psykologia', 'Gestalt-periaatteet', 'Paperiprototyyppi', 'Käyttäjätestaus'],
  readTime: '5 min',
};

const before = [
  {
    src: 'ennen-1-aloitus.jpg',
    alt: 'Alkuperäinen aloitusnäkymä: pieni ohjeteksti ylhäällä ja keskellä iso vihreä painike, jossa lukee Ei opiskelijakorttia.',
    caption: '1. Huomio menee isoon vihreään Ei opiskelijakorttia -painikkeeseen, ei ohjeeseen.',
  },
  {
    src: 'ennen-2-tuotteet.jpg',
    alt: 'Alkuperäinen tuotenäkymä: eriväriset tuotelaatikot hajallaan ympäri näyttöä ja alareunassa vihreä Maksamaan-painike.',
    caption: '2. Tuotteet ovat hajallaan, ja hinta näkyy vain yhdessä niistä.',
  },
  {
    src: 'ennen-3-valitut.jpg',
    alt: 'Alkuperäinen valintanäkymä: kaksi pientä vaaleanpunaista painiketta jälkiruoalle ja kahville, pieni summa oikeassa yläkulmassa ja alareunassa Maksa-painike.',
    caption: '3. Valittu tuote näkyy pienellä, ja huomio vie lisätuotteisiin.',
  },
  {
    src: 'ennen-4-odotetaan-korttia.jpg',
    alt: 'Alkuperäinen maksunäkymä: koko näyttö oranssi, keskellä teksti Odotetaan korttia.',
    caption: '4. Maksu odottaa korttia.',
  },
  {
    src: 'ennen-5-auktorisointi.jpg',
    alt: 'Alkuperäinen maksunäkymä: koko näyttö oranssi, keskellä teksti Auktorisointi, yhdistetään varmentajaan.',
    caption: '5. Onnistumisesta ei kerrota, vaan näkymä palaa suoraan alkuun.',
  },
];

const proto = [
  {
    src: 'proto-1-aloitus.jpg',
    alt: 'Paperiprototyypin aloitusnäkymä: ohje Osta opiskelijalounas täältä, kuva opiskelijakortista ja nuoli kohti QR-lukijaa. Yläkulmassa kielivalinnat FI ja EN sekä ääniopastuksen kuvake.',
    caption: 'Aloitus: yksi selkeä ohje ja nuoli lukijaan.',
  },
  {
    src: 'proto-2-tuotteet.jpg',
    alt: 'Paperiprototyypin tuotenäkymä: neljä samankokoista tuotetta ruudukossa, jokaisessa nimi ja hinta. Oikeassa yläkulmassa Peruuta-painike.',
    caption: 'Tuotteet: samankokoiset laatikot ruudukossa, hinta jokaisessa.',
  },
  {
    src: 'proto-3-valitut.jpg',
    alt: 'Paperiprototyypin tuotenäkymä, jonka alla Valitut tuotteet -lista: opiskelijalounas ja jälkiruoka hintoineen, Poista-painikkeet ja yhteensä 4,90 euroa. Alareunassa Maksamaan-painike.',
    caption: 'Valitut tuotteet ja yhteissumma pysyvät näkyvissä.',
  },
  {
    src: 'proto-4-ostoskori.jpg',
    alt: 'Paperiprototyypin yhteenvetonäkymä: valitut tuotteet ja yhteissumma, painikkeet Muuta tilausta ja Peruuta osto sekä isot Jatka- ja Maksamaan-painikkeet.',
    caption: 'Yhteenveto: tilausta voi muuttaa tai sen voi perua.',
  },
  {
    src: 'proto-5-maksu.jpg',
    alt: 'Paperiprototyypin maksunäkymä: Summa 4,90 euroa ja ohje Seuraa kortinlukijan ohjeita sekä nuoli kohti kortinlukijaa.',
    caption: 'Maksu: summa ja suunta kortinlukijaan.',
  },
  {
    src: 'proto-6-maksu-onnistui.jpg',
    alt: 'Paperiprototyypin vahvistusnäkymä: vihreä laatikko, jossa valkoinen valintamerkki ja teksti Maksu onnistui. Alla muistutus ottaa kuitti mukaan ja näyttää se linjastolla sekä nuoli alaspäin.',
    caption: 'Vahvistus: Maksu onnistui ja muistutus kuitista.',
  },
];
---

<Layout title={`${caseStudy.title.replace('\u00AD', '')} | altmaian.dev`}>
  <main>
    <section class="hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Murupolku">
          <a href="/">Etusivu</a>
          <span class="separator" aria-hidden="true">→</span>
          <span class="current" aria-current="page">Itsepalvelukassa</span>
        </nav>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">Lukuaika {caseStudy.readTime}</span>
          </div>
          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>
          <ul class="tags" aria-label="Aiheet">
            {caseStudy.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
          <dl class="details">
            <div><dt>Rooli</dt><dd>Analyysi, suunnittelu, prototypointi ja testaus</dd></div>
            <div><dt>Tiimi</dt><dd>Yksin</dd></div>
            <div><dt>Konteksti</dt><dd>Psychology in Human-Technology Interaction, Tampereen yliopisto</dd></div>
            <div><dt>Menetelmät</dt><dd>Kognitiivisen psykologian analyysi, Crazy 8, paperiprototyyppi, käyttäjätesti</dd></div>
            <div><dt>Työkalut</dt><dd>Paperi, sakset ja kynä, Figma</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <article class="content-section">
      <div class="container">
        <div class="article-content">

          <section class="section" aria-labelledby="yhteenveto">
            <h2 id="yhteenveto">Yhteenveto</h2>
            <div class="summary-box">
              <p>
                Opiskelijaravintolan itsepalvelukassalla opiskelija tunnistautuu, valitsee lounaan ja maksaa ennen linjastoa.
                Kassa oli hämmentävä: valikot olivat hajallaan, ja onnistunutta maksua ei vahvistettu.
                Analysoin näkymät kognitiivisen psykologian periaatteilla, suunnittelin kulun uudelleen paperiprototyypiksi ja testasin sen käyttäjällä.
              </p>
            </div>
          </section>

          <section class="section" aria-labelledby="lahtotilanne">
            <h2 id="lahtotilanne">Lähtötilanne</h2>
            <p>
              Käytin kassaa itse ja ihmettelin, miksi se tuntui niin epäselvältä. Kun kurssilla piti valita olemassa oleva palvelu ja suunnitella se uudelleen psykologian periaatteiden avulla, valinta oli helppo.
            </p>
            <p>Kassalla on neljä vaihetta:</p>
            <ol>
              <li>Tunnistautuminen opiskelijakortin QR-koodilla</li>
              <li>Tuotteiden valinta</li>
              <li>Maksaminen kortilla</li>
              <li>Kuitin näyttäminen henkilökunnalle linjastolla</li>
            </ol>
          </section>

          <section class="section" aria-labelledby="analyysi">
            <h2 id="analyysi">Analyysi: mihin huomio menee?</h2>
            <p>
              Kävin alkuperäiset näkymät läpi kysyen jokaisessa: mihin käyttäjän huomio menee ensimmäisenä, ja auttaako se häntä eteenpäin?
            </p>
            <ul class="gallery gallery-before" aria-label="Alkuperäisen kassan näkymät">
              {before.map((b) => (
                <li>
                  <figure>
                    <img src={img(b.src)} alt={b.alt} loading="lazy" width="430" height="594" />
                    <figcaption>{b.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>

            <h3>Havainnot</h3>
            <ul>
              <li><strong>Huomio menee väärään paikkaan.</strong> Ensimmäisenä silmään osuu iso vihreä Ei opiskelijakorttia -painike, ei ylhäällä oleva ohje lukea QR-koodi.</li>
              <li><strong>Gestalt-periaatteet puuttuvat.</strong> Tuotelaatikot ovat samankokoisia, mutta hajallaan ympäri näyttöä. Samankaltaisuus ja läheisyys eivät ryhmittele niitä, ja hinta näkyy vain yhdessä tuotteessa.</li>
              <li><strong>Käyttäjä joutuu muistamaan.</strong> Valittu tuote näkyy pienellä fontilla, ja Peruuta ja Poista ovat pieniä tekstilinkkejä sivussa. Huomio vie jälkiruoka- ja kahvipainikkeisiin.</li>
              <li><strong>Loppu jää auki.</strong> Maksun jälkeen näkymä palaa suoraan alkuun. Käyttäjä ei saa vahvistusta siitä, että maksu onnistui.</li>
            </ul>
          </section>

          <section class="section" aria-labelledby="periaatteet">
            <h2 id="periaatteet">Periaatteet, joihin suunnittelu perustuu</h2>
            <div class="feature-grid">
              <div class="feature-card">
                <h3>Havainto ja huomio</h3>
                <p>Tärkein asia on näkymässä isoin ja ensimmäisenä. Tutut symbolit, kuten nuoli ja valintamerkki, huomataan automaattisesti.</p>
              </div>
              <div class="feature-card">
                <h3>Gestalt</h3>
                <p>Samankaltaisuus tuotelaatikoissa, läheisyys ryhmittelyssä, symmetria asettelussa, jatkuvuus näkymästä toiseen ja sulkeuma lopussa.</p>
              </div>
              <div class="feature-card">
                <h3>Työmuisti</h3>
                <p>Kerralla näkyvissä vain se, mitä tässä vaiheessa tarvitaan. Neljä tuotetta, yksi päätoiminto.</p>
              </div>
              <div class="feature-card">
                <h3>Tunnistaminen, ei muistaminen</h3>
                <p>Valitut tuotteet ja yhteissumma pysyvät näkyvissä, joten niitä ei tarvitse pitää mielessä.</p>
              </div>
            </div>
          </section>

          <section class="section" aria-labelledby="ratkaisu">
            <h2 id="ratkaisu">Ratkaisu: paperiprototyyppi</h2>
            <p>
              Ideoin näkymät Crazy 8 -menetelmällä ja askartelin niistä paperiprototyypin. Vaihdettavilla paperipaloilla pystyin näyttämään, miten näkymä muuttuu, kun käyttäjä valitsee tuotteita.
            </p>

            <figure class="video">
              <video controls preload="metadata" playsinline poster={img('paperiprototyyppi-poster.jpg')} aria-describedby="video-kuvaus">
                <source src={img('paperiprototyyppi.mp4')} type="video/mp4" />
              </video>
              <figcaption id="video-kuvaus">
                Video paperiprototyypistä (10 s, ei ääntä): aloitus, tuotteiden valinta ja maksun vahvistus. Valitut tuotteet ilmestyvät Valitut tuotteet -listaan sitä mukaa, kun niitä valitaan.
              </figcaption>
            </figure>

            <ul class="gallery gallery-proto" aria-label="Paperiprototyypin näkymät">
              {proto.map((p) => (
                <li>
                  <figure>
                    <img src={img(p.src)} alt={p.alt} loading="lazy" width="575" height="575" />
                    <figcaption>{p.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>

            <h3>Mitä muutin</h3>
            <ul>
              <li><strong>Yksi selkeä aloitus:</strong> ohje ja nuoli suoraan kortinlukijaan.</li>
              <li><strong>Tuotteet ruudukossa:</strong> samankokoiset laatikot, joissa jokaisessa nimi ja hinta.</li>
              <li><strong>Valitut tuotteet aina näkyvissä:</strong> lista, yhteissumma ja Poista-painike jokaiselle tuotteelle.</li>
              <li><strong>Peruuta ja Muuta tilausta oikeina painikkeina:</strong> virheen voi korjata missä vaiheessa tahansa.</li>
              <li><strong>Selkeä loppu:</strong> Maksu onnistui -vahvistus ja muistutus ottaa kuitti mukaan.</li>
            </ul>
          </section>

          <section class="section" aria-labelledby="testaus">
            <h2 id="testaus">Testaus</h2>
            <p>
              Testasin prototyypin yhdellä käyttäjällä. Käyttäjä kävi läpi koko kulun aloituksesta maksun vahvistukseen, ja minä vaihdoin näkymiä hänen valintojensa mukaan. Testitilanteessa prototyyppi oli pöydällä, ja juuri se osoittautui ongelmaksi.
            </p>

            <h3>Mitä testissä selvisi</h3>
            <ul>
              <li><strong>Kokonaisuus oli selkeä.</strong> Käyttäjän mielestä prototyypissä ei ollut mitään ylimääräistä, ja sitä oli helppo käyttää.</li>
              <li><strong>Konteksti puuttui.</strong> Käyttäjä ei aluksi hahmottanut, mikä laite oli kyseessä ja mitä pitäisi tehdä. Oikea kassa on pystyssä oleva näyttö, mutta prototyyppi makasi pöydällä.</li>
              <li><strong>Aloituskuva oli liian iso.</strong> Aloitusnäkymän ohjekuvan pitäisi olla pienempi tai havainnollisempi.</li>
            </ul>
          </section>

          <section class="section" aria-labelledby="iterointi">
            <h2 id="iterointi">Iterointi: digitaalinen versio</h2>
            <p>
              Testin jälkeen vein näkymät digitaalisiksi rautalankamalleiksi ja korjasin ne havaintojen perusteella.
            </p>
            <h3>Mitä muutin testin jälkeen</h3>
            <ul>
              <li><strong>Selkeä otsikko ja ohje:</strong> aloitusnäkymä kertoo heti, mikä laite on ja mitä tehdään: ”Osta opiskelijalounas. Aloita näyttämällä opiskelijakorttisi QR-koodi lukijalle.”</li>
              <li><strong>Pienempi ohjekuva:</strong> iso kuva vaihtui pieneen puhelimeen, jonka näytöllä on QR-koodi, ja nuoli osoittaa suoraan lukijaan.</li>
              <li><strong>Vaihepalkki:</strong> Tunnistaudu, Valitse ja Maksa näkyvät jokaisessa näkymässä, joten käyttäjä tietää koko ajan, missä vaiheessa hän on ja paljonko on jäljellä.</li>
              <li><strong>Ei opiskelijakorttia -vaihtoehto toissijaisena:</strong> alkuperäisessä kassassa iso vihreä painike vei huomion ohjeelta. Nyt vaihtoehto on olemassa, mutta pienenä tekstilinkkinä alareunassa.</li>
            </ul>

           <ul class="gallery gallery-digi" aria-label="Digitaalisen version näkymät">
              <li>
                <figure>
                  <img src={img('digi-1-aloitus.png')} alt="Digitaalinen aloitusnäkymä: ylhäällä vaihepalkki, jossa ensimmäinen vaihe Tunnistaudu on aktiivinen. Otsikko Osta opiskelijalounas ja ohje näyttää QR-koodi lukijalle. Pieni puhelin, jonka näytöllä on QR-koodi, nuoli alas QR-lukijaan ja alareunassa linkki Ei opiskelijakorttia? Osta ilman opiskelija-alennusta." loading="lazy" width="1080" height="1440" />
                  <figcaption>Aloitus</figcaption>
                </figure>
              </li>
              <li>
                <figure>
                  <img src={img('digi-2-valitse-tuotteet.png')} alt="Tuotteiden valinta: vaihepalkissa Valitse aktiivisena, neljä tuotetta hintoineen ruudukossa, Valitut tuotteet -lista Poista-painikkeineen, yhteensä 4,90 euroa ja Maksamaan-painike." loading="lazy" width="1080" height="1440" />
                  <figcaption>Valitse tuotteet</figcaption>
                </figure>
              </li>
              <li>
                <figure>
                  <img src={img('digi-3-tarkista-tilaus.png')} alt="Tilauksen tarkistus: valitut tuotteet ja yhteissumma, painikkeet Muuta tilausta ja Peruuta ostos sekä iso Jatka maksamaan -painike." loading="lazy" width="1080" height="1440" />
                  <figcaption>Tarkista tilaus</figcaption>
                </figure>
              </li>
              <li>
                <figure>
                  <img src={img('digi-4-maksu-onnistui.png')} alt="Vahvistus: vaihepalkissa kaikki kolme vaihetta tehty, iso valintamerkki ja teksti Maksu onnistui, muistutus ottaa kuitti mukaan ja esittää se linjastolla sekä nuoli alas kuittiin." loading="lazy" width="1080" height="1440" />
                  <figcaption>Maksu onnistui</figcaption>
                </figure>
              </li>
            </ul>

            <p class="ai-note">
              Digitaaliset näkymät tehtiin tekoälyn avulla paperiprototyypin ja testihavaintojen pohjalta. Suunnitteluratkaisut ja muutokset ovat omiani, ja tarkistin jokaisen näkymän.
            </p>
          </section>

          <section class="section" aria-labelledby="saavutettavuus">
            <h2 id="saavutettavuus">Saavutettavuus</h2>
            <ul>
              <li>Kielivalinta (FI/EN) ja ääniopastus näkyvät jokaisessa näkymässä.</li>
              <li>Isot painikkeet ja vähän elementtejä kerrallaan keventävät kognitiivista kuormaa.</li>
              <li>Peruuta, Poista ja Muuta tilausta ovat aina saatavilla, joten virheen voi korjata.</li>
              <li>Onnistumisesta kerrotaan värin lisäksi tekstillä ja valintamerkillä.</li>
              <li>Mustavalkoisessa luonnoksessa väri ei kanna merkitystä, joten kontrastit ovat lähtökohtaisesti hyvät.</li>
            </ul>
          </section>

          <section class="section" aria-labelledby="opit">
            <h2 id="opit">Mitä opin</h2>
            <div class="learnings-box">
              <h3>Mikä toimi</h3>
              <ul>
                <li>Psykologian periaatteet antoivat perustelut jokaiselle ratkaisulle.</li>
                <li>Crazy 8 näytti, miten nopeasti ideat kehittyvät, kun keskittyy olennaiseen.</li>
                <li>Vaihdettavat paperipalat tekivät prototyypistä yllättävän toimivan.</li>
              </ul>
              <h3>Mitä tekisin toisin</h3>
              <ul>
                <li>Kiinnittäisin prototyypin seinälle, jotta käyttötilanne vastaisi oikeaa kassaa.</li>
                <li>Kertoisin testaajalle lyhyesti tilanteen ennen tehtävää.</li>
                <li>Testaisin useammalla käyttäjällä. Viisi testaajaa löytää suurimman osan isoista ongelmista.</li>
                <li>Kiinnittäisin paperipalat sinitarralla, jotta ne pysyvät paikallaan.</li>
              </ul>
              <h3>Seuraavaksi</h3>
              <ul>
                <li>Teen digitaalisista näkymistä klikattavan prototyypin ja testaan sen pystyasennossa olevalla näytöllä useammalla käyttäjällä.</li>
              </ul>
            </div>
          </section>

        </div>

      </div>
    </article>

    <section class="case-nav" aria-label="Sivuston navigointi">
      <div class="container">
        <div class="nav-links">
          <a href="/" class="nav-link center">← Takaisin etusivulle</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables
     ============================================ */
  :root {
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --font-display: 'Space Mono', monospace;
    --font-body: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  main {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ============================================
     Hero
     ============================================ */
  .hero {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-turquoise);
  }

  .breadcrumb .separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .meta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .category {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .date,
  .read-time {
    color: var(--color-text);
    border: 1px solid var(--color-accent-turquoise);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  /* ============================================
     Content Section
     ============================================ */
  .content-section {
    padding: var(--spacing-lg) 0;
  }





  /* ============================================
     Typography
     ============================================ */
  .section {
    margin-bottom: var(--spacing-lg);
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-accent-turquoise);
  }

  .section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .section p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
