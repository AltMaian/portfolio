---
// src/pages/case-studies/kosketusnaytto.astro
import Layout from '../../layouts/Layout.astro';

const img = (name: string) => `/case-studies/kosketusnaytto/${name}`;

const caseStudy = {
  title: 'Kosketusnäyttö rakennustyömaalle',
  subtitle:
    'Julkinen rakennuttaja halusi työmailleen oman näköisensä infonäytön, josta työntekijä löytää turvallisuusohjeet ja tiedotteet ilman opastusta. Selvitin tarpeet, suunnittelin näkymän ja toteutin sen.',
  date: '2018',
  category: 'Käyttöliittymäsuunnittelu',
  tags: ['Kosketusnäyttö', 'Asiakastyö', 'Teemoitus', 'Informaatioarkkitehtuuri'],
  readTime: '4 min',
};
---

<Layout title={`${caseStudy.title} | altmaian.dev`}>
  <main>
    <section class="hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Murupolku">
          <a href="/">Etusivu</a>
          <span class="separator" aria-hidden="true">→</span>
          <span class="current" aria-current="page">Kosketusnäyttö</span>
        </nav>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">Lukuaika {caseStudy.readTime}</span>
          </div>
          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>
          <ul class="tags" aria-label="Aiheet">
            {caseStudy.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
          <dl class="details">
            <div><dt>Oma roolini</dt><dd>Tarpeiden selvitys asiakkaan kanssa, näkymän suunnittelu ja toteutus</dd></div>
            <div><dt>Asiakas</dt><dd>Julkinen rakennuttaja, kahdeksan työmaan toimipistettä</dd></div>
            <div><dt>Konteksti</dt><dd>Oma yritys, asiakasprojekti viestintäjärjestelmän päälle</dd></div>
            <div><dt>Menetelmät</dt><dd>Asiakastapaaminen, näkymäkonsepti, iterointi asiakkaan palautteen perusteella</dd></div>
            <div><dt>Käyttäjät</dt><dd>Rakennustyömaan työntekijät taukotiloissa</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <article class="content-section">
      <div class="container">
        <div class="article-content">

          <section class="section" aria-labelledby="yhteenveto">
            <h2 id="yhteenveto">Yhteenveto</h2>
            <div class="summary-box">
              <p>
                Julkinen rakennuttaja halusi työmaidensa taukotiloihin kosketusnäytön, josta työntekijät löytävät turvallisuusohjeet, työmaan tiedotteet ja hankkeen esittelyn.
                Selvitin tarpeet tapaamalla asiakkaan, suunnittelin asiakkaan brändin mukaisen näkymän ja toteutin sen viestintäjärjestelmän päälle. Konseptin perusteella saimme kaupan.
              </p>
            </div>
          </section>

          <section class="section" aria-labelledby="kayttajat">
            <h2 id="kayttajat">Käyttäjät ja käyttöympäristö</h2>
            <p>
              Näytöt sijaitsivat rakennustyömaiden parakkirakennuksissa. Käyttäjinä olivat työmaan työntekijät, jotka käyttävät näyttöä satunnaisesti, usein tauolla tai ohi kulkiessaan ja seisaaltaan.
            </p>
            <div class="feature-grid">
              <div class="feature-card">
                <h3>Ei opastusta</h3>
                <p>Kukaan ei neuvo näytön käytössä, joten jokaisen toiminnon pitää kertoa itse, mitä se tekee.</p>
              </div>
              <div class="feature-card">
                <h3>Satunnainen käyttö</h3>
                <p>Käyttäjä ei opettele näyttöä. Hänen pitää löytää etsimänsä heti ensimmäisellä kerralla.</p>
              </div>
              <div class="feature-card">
                <h3>Turvallisuus ensin</h3>
                <p>Työturvallisuusohjeiden pitää löytyä nopeasti, joten ne ovat ensimmäinen painike.</p>
              </div>
            </div>
          </section>

          <section class="section" aria-labelledby="tarpeet">
            <h2 id="tarpeet">Tarpeiden selvitys</h2>
            <p>
              Kävin asiakkaan luona palaverissa ja kävimme läpi, mitä tietoa työmaiden pitää välittää työntekijöille. Palaverin toiveiden perusteella tein näkymäkonseptin, ja sen perusteella asiakas teki tilauksen. Asiakkaan pyytämät pienet muutokset tein ennen käyttöönottoa.
            </p>
          </section>

          <section class="section" aria-labelledby="ratkaisu">
            <h2 id="ratkaisu">Ratkaisu</h2>
            <p>
              Aloitusnäkymässä pyörii infoshow, jonka tiedotteet asiakkaan ylläpitäjä vaihtaa viestintäjärjestelmän selainkäyttöliittymässä. Alareunan painikkeista pääsee suoraan turvallisuusohjeisiin, työmaan tietoihin ja hankkeen esittelyyn, ja Alkuun-painike palauttaa aloitusnäkymään.
            </p>
            <figure class="wide wide-full">
              <img src={img('kn-1-aloitus.png')} alt="Kosketusnäytön aloitusnäkymä: keskellä asiakkaan logo ja infoshow, sivuilla isot nuolipainikkeet tiedotteiden selaamiseen ja alareunassa painikkeet Turvallisuus, Työmaa ja Hankkeen esittely, pyöreä Alkuun-painike sekä asiakkaan logo." loading="lazy" width="1600" height="900" />
              <figcaption>Aloitusnäkymä. Rautalankamalli toteutuksesta ilman asiakkaan brändiä.</figcaption>
            </figure>
            <figure class="wide wide-full">
              <img src={img('kn-2-turvallisuus.png')} alt="Turvallisuus-näkymä: otsikko, ohjeteksti ja kuva, alareunassa sivunumero 3/6. Sivuilla nuolipainikkeet ja alareunan painikkeet pysyvät samoina." loading="lazy" width="1600" height="900" />
              <figcaption>Sisältönäkymä. Alareunan painikkeet pysyvät samassa paikassa jokaisessa näkymässä.</figcaption>
            </figure>

            <h3>Päätös: nuolipainikkeet pyyhkäisyn sijaan</h3>
            <p>
              Infokuvia selataan isoilla nuolipainikkeilla eikä pyyhkäisemällä. Painike näkyy ja kertoo itse, että sisältöä voi selata. Pyyhkäisy on piilotettu ele, jota seinällä olevan näytön satunnainen käyttäjä ei välttämättä keksi.
            </p>

            <h3>Yhteinen pohja, asiakkaan brändi</h3>
            <p>
              Näkymän rakenne, painikkeet ja toiminnot ovat samat kaikille asiakkaille. Asiakaskohtaisesti vaihtuvat värit, logot ja kuvat. Näin yksi tuote taipuu eri asiakkaiden näköiseksi.
            </p>
            <p>
              Teknisesti näkymä oli kuva, jonka kosketusalueet määriteltiin näytölle pikselin tarkkuudella. Painikkeiden koko suunniteltiin kosketusnäytön mukaan.
            </p>
          </section>

          <section class="section" aria-labelledby="toisin">
            <h2 id="toisin">Mitä tekisin nyt toisin</h2>

            <figure class="wide wide-full">
              <img src={img('kn-4-parannettu.png')} alt="Parannettu kosketusnäkymä: tummanturkoosi tausta. Ylhäällä otsikko Työmaan info ja ohje Kosketa painiketta tai selaa tiedotteita nuolilla, kielivalinnat FI, EN, RU ja ET sekä logon paikka. Keskellä valkoinen tiedotekortti otsikolla Nostotyöt maanantaina klo 7–11, tekstiä, kuva ja sivunumero 2/5. Sivuilla isot valkoiset painikkeet Edellinen ja Seuraava, joissa on nuoli ja teksti. Alareunassa neljä samankokoista painiketta ikoneineen: Turvallisuus, Työmaa, Hankkeen esittely ja Alkuun, joista Alkuun on valittuna keltaisella." loading="lazy" width="1600" height="900" />
              <figcaption>Konsepti: samat toiminnot, selkeämpi ja saavutettavampi toteutus.</figcaption>
            </figure>
            <ul>
              <li><strong>Otsikko ja ohje:</strong> näkymä kertoo heti, mikä se on ja miten sitä käytetään.</li>
              <li><strong>Nuolipainikkeissa teksti:</strong> Edellinen ja Seuraava, ei pelkkä symboli.</li>
              <li><strong>Sivunumero:</strong> käyttäjä näkee, montako tiedotetta on ja missä kohdassa hän on.</li>
              <li><strong>Yhtenäiset painikkeet:</strong> neljä samankokoista isoa painiketta ikonilla ja tekstillä. Valittu painike erottuu värin lisäksi tekstillä Valittu.</li>
              <li><strong>Kielivalinta:</strong> työmailla työskentelee usein eri kieliä puhuvia ihmisiä.</li>
              <li><strong>Kontrasti:</strong> tumma teksti valkoisella ja valkoinen teksti tummalla taustalla.</li>
            </ul>

            <p class="ai-note">
              Rautalankamallit ja parannettu konsepti tehtiin tekoälyn avulla toteutuksen ja yllä olevien havaintojen pohjalta. Malleista on poistettu asiakkaan nimi ja brändi.
            </p>
          </section>

        </div>
      </div>
    </article>

    <section class="case-nav" aria-label="Sivuston navigointi">
      <div class="container">
        <div class="nav-links">
          <a href="/" class="nav-link center">← Takaisin etusivulle</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables
     ============================================ */
  :root {
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --font-display: 'Space Mono', monospace;
    --font-body: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  main {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ============================================
     Hero
     ============================================ */
  .hero {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-turquoise);
  }

  .breadcrumb .separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .meta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .category {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .date,
  .read-time {
    color: var(--color-text);
    border: 1px solid var(--color-accent-turquoise);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  /* ============================================
     Content Section
     ============================================ */
  .content-section {
    padding: var(--spacing-lg) 0;
  }





  /* ============================================
     Typography
     ============================================ */
  .section {
    margin-bottom: var(--spacing-lg);
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-accent-turquoise);
  }

  .section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .section p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .section ul,
  .section ol {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .section li {
    margin-bottom: 0.5rem;
  }

  .section strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .section em {
    color: var(--color-accent-turquoise);
    font-style: italic;
  }

  /* ============================================
     Special Boxes
     ============================================ */
  .summary-box {
    background: rgba(6, 214, 160, 0.08);
    border-left: 4px solid var(--color-accent-turquoise);
    padding: var(--spacing-md);
    border-radius: 0 4px 4px 0;
    margin-bottom: var(--spacing-md);
  }

  .summary-box p {
    margin: 0;
    color: var(--color-text);
  }

  .quote-box {
    background: var(--color-bg-secondary);
    border-left: 4px solid var(--color-accent-purple);
    padding: var(--spacing-md);
    margin: var(--spacing-md) 0;
    border-radius: 0 4px 4px 0;
  }

  .quote {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-text);
    margin: 0;
  }

  .learnings-box {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .learnings-box h3 {
    color: var(--color-accent-turquoise);
    margin-top: var(--spacing-md);
  }

  .learnings-box h3:first-child {
    margin-top: 0;
  }

  .learnings-box ul {
    margin-bottom: 0;
  }

  /* ============================================
     Feature Grid
     ============================================ */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .feature-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(6, 214, 160, 0.3);
    transform: translateY(-4px);
  }

  .feature-card h3 {
    font-size: 1.125rem;
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .feature-card p {
    font-size: 0.95rem;
    margin: 0;
  }

  /* ============================================
     Results Grid
     ============================================ */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .result-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .metric {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent-turquoise);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .metric-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* ============================================
     Sidebar
     ============================================ */
  .sidebar {
    position: sticky;
    top: var(--spacing-md);
    height: fit-content;
  }

  .sidebar-section {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    margin-bottom: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-section h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .details-list {
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .details-list dt {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
  }

  .details-list dd {
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .related-links {
    list-style: none;
    padding: 0;
  }

  .related-links li {
    margin-bottom: 0.75rem;
  }

  .related-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  .related-links a:hover {
    color: var(--color-accent-turquoise);
  }

  .related-links a::before {
    content: '→ ';
    color: var(--color-accent-turquoise);
  }

  /* ============================================
     Case Navigation
     ============================================ */
  .case-nav {
    padding: var(--spacing-lg) 0;
    background: var(--color-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-body);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    padding: var(--spacing-sm);
    border-radius: 4px;
  }

  .nav-link:hover {
    color: var(--color-accent-turquoise);
    background: rgba(6, 214, 160, 0.05);
  }

  .nav-link.prev {
    text-align: left;
  }

  .nav-link.next {
    text-align: right;
    justify-self: end;
  }

  .nav-link.center {
    text-align: center;
    font-weight: 600;
  }

  .nav-label {
    display: block;
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
    opacity: 0.7;
  }

  .nav-title {
    display: block;
    font-size: 1rem;
    font-weight: 600;
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 1024px) {
    .content-section .container {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      max-width: 600px;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .nav-link.prev,
    .nav-link.next {
      text-align: center;
      justify-self: stretch;
    }

    .feature-grid,
    .results-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================
     Focus Styles
     ============================================ */
  a:focus-visible {
    outline: 2px solid var(--color-accent-turquoise);
    outline-offset: 4px;
  }

  /* ============================================
     Case: lists, galleries, video
     ============================================ */
  .tags { list-style: none; padding: 0; margin: 0; }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--spacing-sm) var(--spacing-md);
    margin: var(--spacing-md) 0 0;
    padding: var(--spacing-md);
    background: var(--color-bg-secondary);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-family: var(--font-body);
  }

  .details dt {
    font-size: 0.875rem;
    color: var(--color-accent-turquoise);
    margin-bottom: 0.25rem;
  }

  .details dd {
    margin: 0;
    color: var(--color-text);
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .container { padding: 0 1.25rem; }
  }

  .sidebar-title {
    font-family: var(--font-display);
    font-size: 1rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .section .gallery {
    list-style: none;
    padding: 0;
    margin: var(--spacing-md) 0;
    display: grid;
    gap: var(--spacing-sm);
  }

  .gallery-before { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  .gallery-proto { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }

  .gallery li { margin: 0; }

  figure { margin: 0; }

  .gallery img,
  .wide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  figcaption {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .video,
  .wide {
    margin: var(--spacing-md) 0;
  }

  .video video {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 8px;
    background: var(--color-bg-secondary);
  }

  .wide img { max-width: 420px; }

  .section ol { list-style: decimal; }
  .section ul:not(.gallery):not(.tags) { list-style: disc; }

  .nav-links:has(> :only-child) { grid-template-columns: 1fr; justify-items: center; }

