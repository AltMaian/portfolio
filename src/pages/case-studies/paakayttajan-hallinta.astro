---
// src/pages/case-studies/paakayttajan-hallinta.astro
import Layout from '../../layouts/Layout.astro';

const img = (name: string) => `/case-studies/paakayttajan-hallinta/${name}`;

const caseStudy = {
  title: 'Pääkäyttäjän työkalut itsepalveluun',
  subtitle:
    'Lisenssiostoa muutettiin niin, että asiakkaan pääkäyttäjän pitää pystyä hallitsemaan käyttäjiä, käyttöoikeuksia ja lisenssejä itse. Suunnittelin ja toteutin nämä näkymät B2B SaaS -ohjelmistoon.',
  date: '2024',
  category: 'Käyttöliittymäsuunnittelu',
  tags: ['B2B SaaS', 'Itsepalvelu', 'Roolipohjaiset näkymät', 'Frontend'],
  readTime: '5 min',
};
---

<Layout title={`${caseStudy.title} | altmaian.dev`}>
  <main>
    <section class="hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Murupolku">
          <a href="/">Etusivu</a>
          <span class="separator" aria-hidden="true">→</span>
          <span class="current" aria-current="page">Pääkäyttäjän työkalut</span>
        </nav>

        <div class="hero-content">
          <div class="meta">
            <span class="category">{caseStudy.category}</span>
            <span class="date">{caseStudy.date}</span>
            <span class="read-time">Lukuaika {caseStudy.readTime}</span>
          </div>
          <h1 class="page-title">{caseStudy.title}</h1>
          <p class="subtitle">{caseStudy.subtitle}</p>
          <ul class="tags" aria-label="Aiheet">
            {caseStudy.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>
          <dl class="details">
            <div><dt>Oma roolini</dt><dd>Näkymien suunnittelu ja käyttöliittymän toteutus</dd></div>
            <div><dt>Tiimi</dt><dd>Kaksi kehittäjää: minä käyttöliittymä, toinen kehittäjä backend</dd></div>
            <div><dt>Konteksti</dt><dd>Työprojekti ohjelmistoyrityksessä, B2B SaaS -viestintäjärjestelmä</dd></div>
            <div><dt>Menetelmät</dt><dd>Tehtäväanalyysi asentajien työstä, roolipohjainen rajaus, käytettävyystesti</dd></div>
            <div><dt>Työkalut</dt><dd>ASP.NET Razor, C#, REST API</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <article class="content-section">
      <div class="container">
        <div class="article-content">

          <section class="section" aria-labelledby="yhteenveto">
            <h2 id="yhteenveto">Yhteenveto</h2>
            <div class="summary-box">
              <p>
                Viestintäohjelmisto haluttiin myyntiin kansainvälisesti niin, että asiakas ottaa sen käyttöön itse. Aiemmin yrityksen asentajat tekivät käyttäjä- ja lisenssiasetukset asiakkaan puolesta.
                Suunnittelin ja toteutin pääkäyttäjälle näkymät, joilla hän hoitaa nämä asiat itse. Testissä pääkäyttäjän tehtävät onnistuivat, ja arvosana oli 5/5.
              </p>
            </div>
          </section>

          <section class="section" aria-labelledby="lahtotilanne">
            <h2 id="lahtotilanne">Lähtötilanne</h2>
            <p>
              Ohjelmistolla yritykset ja organisaatiot näyttävät tiedotteita info-näytöillä. Suomessa asiakas sai kaiken valmiina: asentajat lisäsivät käyttäjät, antoivat heille oikeudet näyttöihin ja kohdistivat lisenssit oikeille näytöille.
            </p>
            <p>
              Kun ohjelmisto tuli myyntiin Microsoftin kansainvälisille kauppapaikoille, asentajaa ei enää ollut. <strong>Kaiken, minkä asentaja ennen teki, piti onnistua asiakkaalta itseltään.</strong>
            </p>
          </section>

          <section class="section" aria-labelledby="tarpeet">
            <h2 id="tarpeet">Mistä tarpeet tulivat</h2>
            <p>
              Tunsin tarpeet omasta työstäni: olimme itse ne asentajat, jotka tekivät nämä tehtävät asiakkaan puolesta. Listasin tehtävät, joita asennuksessa ja ylläpidossa toistui:
            </p>
            <ul>
              <li>käyttäjien lisääminen ja poistaminen</li>
              <li>käyttöoikeudet: kuka saa lisätä sisältöä millekin näytölle</li>
              <li>käyttäjä- ja näyttöryhmät</li>
              <li>lisenssien kohdistaminen näytöille</li>
              <li>tilauksen ja lisenssien tilanteen tarkistaminen</li>
              <li>API-avainten salliminen tai estäminen.</li>
            </ul>
            <p>
              <strong>Rooli rajasi näkymää.</strong> Pääkäyttäjä on organisaatiossa se, joka on tehnyt tilauksen. Tilaus- ja lisenssitiedot eivät kuulu muille käyttäjille, joten nämä työkalut näkyvät vain pääkäyttäjälle. Muut käyttäjät lisäävät sisältöä eivätkä näe hallintaa lainkaan.
            </p>
          </section>

          <section class="section" aria-labelledby="ratkaisu">
            <h2 id="ratkaisu">Ratkaisu</h2>
            <p>
              Toteutin hallinnan dialogina, jossa jokaisella toiminnolla on oma välilehtensä. Ensimmäisenä aukeavat käyttöoikeudet ja käyttäjien lisääminen, koska ne ovat käyttöönoton ensimmäiset askeleet.
            </p>
            <figure class="wide wide-full">
              <img src={img('alkup-1-kayttajat.png')} alt="Hallintadialogi, jossa kuusi välilehteä. Käyttäjien hallinta -välilehdellä vasemmalla käyttäjälista valintaruuduin ja oikealla kolme erillistä lomaketta: lisää käyttäjä, poista käyttäjä sekä salli tai estä API-avain." loading="lazy" width="1200" height="760" />
              <figcaption>Käyttäjien hallinta. Yksinkertaistettu rautalankamalli toteutetusta näkymästä.</figcaption>
            </figure>
            <div class="pair">
              <figure>
                <img src={img('alkup-2-lisenssit.png')} alt="Organisaation lisenssit -taulukko: tilaustunnus, kappalemäärä, päättymispäivä, tarkennus ja tila. Taulukon alla voimassa olevien lisenssien määrä 22." loading="lazy" width="1200" height="760" />
                <figcaption>Organisaation lisenssit</figcaption>
              </figure>
              <figure>
                <img src={img('alkup-3-lisenssien-hallinta.png')} alt="Lisenssien hallinta: laskuri Valitut näytöt/aktiiviset lisenssit 5/22, näyttölista valintaruuduin ja Tallenna muutokset -painike." loading="lazy" width="1200" height="760" />
                <figcaption>Lisenssien hallinta</figcaption>
              </figure>
            </div>

            <h3>Suunnittelupäätökset</h3>
            <ul>
              <li><strong>Varmistus ennen poistoa.</strong> Poistaminen kysyy aina vahvistuksen ja kertoo, mitä poistossa tapahtuu, esimerkiksi että myös ryhmän jäsenyydet poistuvat.</li>
              <li><strong>Lisenssin siirto ilman varmistusta.</strong> Lisenssin siirtäminen toiselle näytölle on vain eri näytön käyttöönottoa, ja sen voi tehdä takaisin. Turha varmistus olisi hidastanut työtä.</li>
              <li><strong>Laskuri lisensseille.</strong> Lisenssien hallinnassa näkyy, montako näyttöä on valittu suhteessa aktiivisiin lisensseihin.</li>
            </ul>
            <figure class="wide">
              <img src={img('alkup-4-poisto.png')} alt="Vahvistusdialogi: Haluatko varmasti poistaa valitun käyttäjäryhmän ja myös kaikki ryhmän jäsenyydet? (0). Painikkeet Peruuta ja Poista." loading="lazy" width="760" height="300" />
              <figcaption>Vahvistus ennen käyttäjäryhmän poistoa</figcaption>
            </figure>
          </section>

          <section class="section" aria-labelledby="tulos">
            <h2 id="tulos">Tulos</h2>
            <p>
              Näkymät testattiin osana <a href="/case-studies/kayttoopas">opinnäytetyöni käytettävyystestiä</a>. Viisi pääkäyttäjän roolissa testannutta lisäsi ja poisti käyttäjän, muutti käyttöoikeuksia ja siirsi lisenssin toiselle näytölle pelkkiä ohjeita seuraten. Kaikki onnistuivat, ja pääkäyttäjän tehtävien käytettävyys sai arvosanan 5/5.
            </p>
          </section>

          <section class="section" aria-labelledby="toisin">
            <h2 id="toisin">Mitä tekisin nyt toisin</h2>
            <p>
              Ratkaisu toimi, mutta HTI- ja saavutettavuusopintojen jälkeen näen siinä selviä parannuskohtia:
            </p>
            <ul>
              <li><strong>Oma sivu dialogin sijaan.</strong> Hallinta on pääkäyttäjälle oma työtehtävänsä, ei pikainen sivutoiminto. Dialogissa listat jäävät pieniksi, eikä näkymää saa suurennettua.</li>
              <li><strong>Selkeämpi rakenne.</strong> Kuusi välilehteä sekoittaa asioita ja niiden välisiä suhteita. Kolme pääkohtaa: Käyttäjät, Näytöt sekä Tilaus ja lisenssit, olisi helpompi hahmottaa.</li>
              <li><strong>Taulukko ja rivikohtaiset toiminnot.</strong> Taulukossa näkyy kaikki olennainen kerralla, ja toiminnot ovat siinä rivillä, jota ne koskevat.</li>
              <li><strong>Oikeat lomake-elementit.</strong> Yhden käyttäjän valinta tehtiin valintaruuduilla, joista voi valita useita.</li>
              <li><strong>Yhtenäinen tallennus.</strong> Osa välilehdistä vaati Tallenna-painikkeen ja osa toiminnoista tapahtui heti. Yksi tapa koko näkymässä kertoisi käyttäjälle varmasti, tallentuiko muutos. Myös design principlet sekä psykologia tukee tätä suunnittelutapaa.</li>
              <li><strong>Tärkein tieto ensin.</strong> Lisenssien yhteenveto ylös, päättyneet tilaukset erilleen, päivämäärät ilman sekunteja ja tilat suomeksi.</li>
              <li><strong>Täsmälliset painiketekstit ja kontrastit.</strong> "OK" tilalle "Luo ryhmä", ja aktiivisen välilehden tekstin kontrasti tarkistettaisiin.</li>
            </ul>

            <h3>Uudistuskonsepti</h3>
            <p class="plan-note">Konsepti, ei toteutettu.</p>
            <figure class="wide wide-full">
              <img src={img('konsepti-1-kayttajat.png')} alt="Uudistuskonsepti: oma hallintasivu, jonka vasemmassa reunassa on navigaatio Käyttäjät, Näytöt sekä Tilaus ja lisenssit. Käyttäjät-sivulla on hakukenttä, Lisää käyttäjä -painike ja taulukko, jossa näkyvät sähköposti, rooli, näytöt ja API-avaimen tila tekstinä sekä rivikohtaiset Muokkaa- ja Poista-painikkeet." loading="lazy" width="1200" height="760" />
              <figcaption>Käyttäjät omalla sivulla: taulukko ja rivikohtaiset toiminnot.</figcaption>
            </figure>
            <div class="pair">
              <figure>
                <img src={img('konsepti-2-lisenssit.png')} alt="Uudistuskonsepti: Tilaus ja lisenssit -sivu, jossa ylhäällä yhteenvetokortit 22 voimassa, 5 käytössä, 17 vapaana ja seuraava päättyy 31.12.2026. Alla voimassa olevat tilaukset, päättyneet tilaukset avattavana linkkinä ja osio lisenssien käytöstä näytöillä." loading="lazy" width="1200" height="760" />
                <figcaption>Tilaus ja lisenssit: yhteenveto ensin.</figcaption>
              </figure>
              <figure>
                <img src={img('konsepti-3-poisto.png')} alt="Uudistuskonseptin vahvistusdialogi: Poistetaanko käyttäjä maria@esimerkki.fi? Käyttäjä menettää pääsyn organisaation näyttöihin. Poistoa ei voi perua. Painikkeet Peruuta ja Poista käyttäjä." loading="lazy" width="760" height="300" />
                <figcaption>Vahvistus, joka kertoo seuraukset ja jonka painike nimeää toiminnon.</figcaption>
              </figure>
            </div>

            <p class="ai-note">
              Rautalankamallit tehtiin tekoälyn avulla. Toteutettujen näkymien mallit perustuvat kuvakaappauksiini, ja niistä on poistettu yrityksen nimi ja oikeat tiedot. Konseptin mallit perustuvat yllä oleviin havaintoihini.
            </p>
          </section>

          <section class="section" aria-labelledby="opit">
            <h2 id="opit">Mitä opin</h2>
            <div class="learnings-box">
              <h3>Mikä toimi</h3>
              <ul>
                <li>Tarpeet tulivat suoraan asentajien työstä, joten mitään olennaista ei jäänyt pois.</li>
                <li>Roolipohjainen rajaus: jokainen näkee vain sen, mikä hänelle kuuluu.</li>
                <li>Kun suunnittelija myös toteuttaa, ideasta pääsee nopeasti toimivaan versioon.</li>
              </ul>
              <h3>Mitä tekisin toisin</h3>
              <ul>
                <li>Testaisin näkymät oikeilla pääkäyttäjillä jo luonnosvaiheessa, en vasta valmiina.</li>
                <li>Tarkistaisin näppäimistökäytön ja ruudunlukijan toiminnan ennen julkaisua.</li>
              </ul>
            </div>
          </section>

        </div>
      </div>
    </article>

    <section class="case-nav" aria-label="Sivuston navigointi">
      <div class="container">
        <div class="nav-links">
          <a href="/" class="nav-link center">← Takaisin etusivulle</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables
     ============================================ */
  :root {
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --font-display: 'Space Mono', monospace;
    --font-body: 'Atkinson Hyperlegible', system-ui, sans-serif;
  }

  main {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ============================================
     Hero
     ============================================ */
  .hero {
    padding: var(--spacing-lg) 0 var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .breadcrumb {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-turquoise);
  }

  .breadcrumb .separator {
    margin: 0 0.5rem;
    opacity: 0.5;
  }

  .breadcrumb .current {
    color: var(--color-text);
  }

  .meta {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .category {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .date,
  .read-time {
    color: var(--color-text);
    border: 1px solid var(--color-accent-turquoise);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-sm);
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    max-width: 900px;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  /* ============================================
     Content Section
     ============================================ */
  .content-section {
    padding: var(--spacing-lg) 0;
  }





  /* ============================================
     Typography
     ============================================ */
  .section {
    margin-bottom: var(--spacing-lg);
  }

  .section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-accent-turquoise);
  }

  .section h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }

  .section p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
  }

  .section ul,
  .section ol {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--spacing-sm);
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .section li {
    margin-bottom: 0.5rem;
  }

  .section strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .section em {
    color: var(--color-accent-turquoise);
    font-style: italic;
  }

  /* ============================================
     Special Boxes
     ============================================ */
  .summary-box {
    background: rgba(6, 214, 160, 0.08);
    border-left: 4px solid var(--color-accent-turquoise);
    padding: var(--spacing-md);
    border-radius: 0 4px 4px 0;
    margin-bottom: var(--spacing-md);
  }

  .summary-box p {
    margin: 0;
    color: var(--color-text);
  }

  .quote-box {
    background: var(--color-bg-secondary);
    border-left: 4px solid var(--color-accent-purple);
    padding: var(--spacing-md);
    margin: var(--spacing-md) 0;
    border-radius: 0 4px 4px 0;
  }

  .quote {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-text);
    margin: 0;
  }

  .learnings-box {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .learnings-box h3 {
    color: var(--color-accent-turquoise);
    margin-top: var(--spacing-md);
  }

  .learnings-box h3:first-child {
    margin-top: 0;
  }

  .learnings-box ul {
    margin-bottom: 0;
  }

  /* ============================================
     Feature Grid
     ============================================ */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .feature-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(6, 214, 160, 0.3);
    transform: translateY(-4px);
  }

  .feature-card h3 {
    font-size: 1.125rem;
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .feature-card p {
    font-size: 0.95rem;
    margin: 0;
  }

  /* ============================================
     Results Grid
     ============================================ */
  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
    margin: var(--spacing-md) 0;
  }

  .result-card {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .metric {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-accent-turquoise);
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .metric-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* ============================================
     Sidebar
     ============================================ */
  .sidebar {
    position: sticky;
    top: var(--spacing-md);
    height: fit-content;
  }

  .sidebar-section {
    background: var(--color-bg-secondary);
    padding: var(--spacing-md);
    border-radius: 8px;
    margin-bottom: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-section h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-accent-turquoise);
  }

  .details-list {
    font-family: var(--font-body);
    font-size: 0.95rem;
  }

  .details-list dt {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
  }

  .details-list dd {
    color: var(--color-text);
    margin-bottom: var(--spacing-sm);
  }

  .related-links {
    list-style: none;
    padding: 0;
  }

  .related-links li {
    margin-bottom: 0.75rem;
  }

  .related-links a {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  .related-links a:hover {
    color: var(--color-accent-turquoise);
  }

  .related-links a::before {
    content: '→ ';
    color: var(--color-accent-turquoise);
  }

  /* ============================================
     Case Navigation
     ============================================ */
  .case-nav {
    padding: var(--spacing-lg) 0;
    background: var(--color-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-links {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-body);
    text-decoration: none;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    padding: var(--spacing-sm);
