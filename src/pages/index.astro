---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

const tampere = [
  {
    title: 'Suoritetut',
    courses: [
      { name: 'Psychology in Human-Technology Interaction' },
      { name: 'User Interfaces and Human-Centred Design' },
    ],
  },
  {
    title: 'Meneillään',
    courses: [
      { name: 'Principles of Service Design' },
      { name: 'User Interface Design: Principles, Methods, and Tools' },
    ],
  },
  {
    title: 'Saavutettavuusopinnot (meneillään)',
    courses: [
      { name: 'Fundamentals of Accessibility' },
      { name: 'Accessibility and User Experience' },
      { name: 'Web Accessibility I (technical)' },
      { name: 'Web Accessibility II (content)' },
      { name: 'Trends in Accessibility' },
    ],
  },
];

const hamk = [
  { name: 'Web Accessibility' },
  { name: 'Johdatus graafisen käyttöliittymän ohjelmointiin' },
  { name: 'Ohjelmiston suunnittelumenetelmät' },
  { name: 'Ohjelmistotestaus' },
  { name: 'Ketterä kehitysprojekti' },
  { name: 'Design Factory Project' },
  { name: 'Sosiaalisen ja digitaalisen median analytiikka' },
  { name: 'Mobile Programming -opintokokonaisuus' },
  { name: 'Kyberturvallisuuden opintokokonaisuus' },
  { name: 'Opinnäytetyö: käytettävyyden arviointi' },
];
---

<Layout title="altmaian.dev">
  <main>
    <!-- Hero Section -->
<section class="hero-section" aria-labelledby="hero-otsikko">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-container">
    <div class="hero-text">
      <p class="open">
        <span class="dot" aria-hidden="true"></span>
        Avoin uusille työmahdollisuuksille
      </p>
      <h1 id="hero-otsikko" class="hero-title">
        Hei! Olen <span class="highlight">Maiju</span>
      </h1>
      <p class="role">UI/UX-suunnittelija · saavutettavuus</p>
<p class="lead">Olen aloittanut itseoppineena kehittäjänä ja ollut ohjelmistoalalla yli 15 vuotta.</p>
<p class="lead">Opiskelen tietojenkäsittelytieteiden maisteriksi Tampereen yliopistossa Human-Technology Interaction -opintosuunnalla.</p>
<p class="lead">Erityinen mielenkiinnon kohteeni on saavutettavien ohjelmistojen suunnittelu ja toteutus. Tämä portfolio toimii dokumentaationa asiantuntijuudestani.</p>
    </div>
    <div class="portrait">
      <img src="/maiju.jpg" alt="Maiju Kalliokoski" width="540" height="540" />
    </div>
  </div>
</section>

<!-- Case Studies -->
<section class="cases-section" id="case-studyt" aria-labelledby="case-studyt-otsikko">
  <div class="cs-container">
    <h2 id="case-studyt-otsikko" class="cs-title">Case studyt</h2>
    <ul class="case-cards">
      <li>
        <article class="case-card">
          <img src="/case-studies/kayttoopas/kuvitus.svg" alt="" width="400" height="240" loading="lazy" />
          <div class="case-card-body">
            <p class="case-card-tag">Käytettävyys</p>
            <h3>
              <a href="/case-studies/kayttoopas" class="case-card-link">Käyttöopas itsenäiseen käyttöönottoon</a>
            </h3>
            <p>Suunnittelin B2B SaaS -ohjelmistolle käyttöoppaan kolmelle käyttäjäryhmälle ja testasin sen 15 käyttäjällä. Opinnäytetyö.</p>
            <p class="case-card-more" aria-hidden="true">Lue case →</p>
          </div>
        </article>
      </li>
      <li>
        <article class="case-card">
          <img src="/case-studies/student-life/kuvitus.svg" alt="" width="400" height="240" loading="lazy" />
          <div class="case-card-body">
            <p class="case-card-tag">Käyttäjätutkimus</p>
            <h3>
              <a href="/case-studies/student-life" class="case-card-link">Haastattelut muuttivat suunnan</a>
            </h3>
            <p>Haastattelut kumosivat oletuksemme: raha rajaa opiskelijoita myös sosiaalisen elämän ulkopuolelle. Suunnittelin sovellukseen Student Life -osion.</p>
            <p class="case-card-more" aria-hidden="true">Lue case →</p>
          </div>
        </article>
      </li>
      <li>
        <article class="case-card">
          <img src="/case-studies/itsepalvelukassa/kuvitus.svg" alt="" width="400" height="240" loading="lazy" />
          <div class="case-card-body">
            <p class="case-card-tag">Käyttöliittymäsuunnittelu</p>
            <h3>
              <a href="/case-studies/itsepalvelukassa" class="case-card-link">Opiskelijaravintolan maksupääte</a>
            </h3>
            <p>Analysoin itsepalvelukassan kognitiivisen psykologian avulla, suunnittelin sen uudelleen paperiprototyypiksi ja testasin käyttäjällä.</p>
            <p class="case-card-more" aria-hidden="true">Lue case →</p>
          </div>
        </article>
      </li>
    </ul>
  </div>
</section>

    <!-- What I Do -->
    <section class="what-i-do">
      <div class="container">
        <h2>Mitä teen?</h2>
        <div class="grid">
          <div class="card card-1">
            <div class="card-icon" aria-hidden="true">🎨</div>
            <h3>Suunnittelen selkeitä ja ymmärrettäviä käyttöliittymiä.</h3>
          </div>
          <div class="card card-2">
            <div class="card-icon" aria-hidden="true">💻</div>
            <h3>Koodaan saavutettavia komponentteja ja mobiilisovellusta.</h3>
          </div>
          <div class="card card-3">
            <div class="card-icon" aria-hidden="true">🔍</div>
            <h3>Auditoin palveluiden saavutettavuutta teknisesti ja käyttäjän näkökulmasta.</h3>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects & Case Studies -->
    <section class="projects-section">
      <div class="container">
        <h2 class="section-title">Projektit</h2>
        <!-- Featured Project -->
        <div class="featured-project">
          <span class="badge">Kehitteillä</span>
          <h3>AltMaian Learn</h3>
          <p class="project-description">
            Flutter-mobiilisovellus ja verkkopalvelu, joka opettaa digitaalisen saavutettavuuden perusteet kaikille aiheesta kiinnostuneille. Samalla se on oma oppimispolkuni saavutettavaan kehitykseen.
          </p>
          <div class="project-tech">
            <span class="tech-tag">Flutter</span>
            <span class="tech-tag">Dart</span>
            <span class="tech-tag">Accessibility</span>
            <span class="tech-tag">iOS</span>
            <span class="tech-tag">Android</span>
            <span class="tech-tag">Web</span>
          </div>
          <div class="project-links">
          <a href="https://github.com/AltMaian/altmaian-learn" 
               target="_blank" 
               rel="noopener noreferrer"
               class="link-github">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub <span class="visually-hidden">: altmaian learn (avautuu uuteen välilehteen)</span>
            </a>
          </div>
        </div>


        <!-- Featured Project -->
        <div class="featured-project">
          <span class="badge">Kehitteillä</span>
          <h3>Inclusive Starter</h3>
          <p class="project-description">
            Open source -komponenttikirjasto, joka tekee saavutettavasta 
            kehityksestä helpompaa. Empaattiset virheviestit, auto-save, 
            ja muut työkalut oikeille ihmisille.
          </p>
          <div class="project-tech">
            <span class="tech-tag">React</span>
            <span class="tech-tag">TypeScript</span>
            <span class="tech-tag">Accessibility</span>
          </div>
          <div class="project-links">
            <a href="https://github.com/Altmaian/inclusive-starter" 
               target="_blank"
               rel="noopener noreferrer"
               class="link-github">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub <span class="visually-hidden">: altmaian inclusive-starter (avautuu uuteen välilehteen)</span>
            </a>
          </div>
        </div>
    </section>

    <!-- Studies/Courses -->
<section class="courses-section" aria-labelledby="opinnot-otsikko">
  <div class="co-container">
    <h2 id="opinnot-otsikko" class="co-title">Opinnot</h2>

    <div class="co-grid">
      <div class="co-card">
        <h3>Tampereen yliopisto</h3>
        <p class="co-sub">Tietojenkäsittelytieteiden maisteriohjelma · Human-Technology Interaction · 2026–</p>
        {tampere.map((group) => (
          <div class="co-group">
            <h4>{group.title}</h4>
            <ul>
              {group.courses.map((c) => (
                <li>
                  {c.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="co-card">
        <h3>Hämeen ammattikorkeakoulu</h3>
        <p class="co-sub">Tradenomi, tietojenkäsittely · 2024</p>
        <div class="co-group">
          <h4>Valitut opinnot</h4>
          <ul>
            {hamk.map((c) => (
              <li>
                {c.name}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

    <!-- Contact -->
    <section class="contact">
      <div class="container">
        <div class="contact-content">
          <div class="social-links">
            <a href="https://github.com/Altmaian" target="_blank" rel="noopener noreferrer" class="social-link">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub <span class="visually-hidden">: altmaian github (avautuu uuteen välilehteen)</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ============================================
     CSS Variables - Dark Theme with Turquoise & Purple
     ============================================ */
  :root {
    /* Colors */
    --color-bg: #0a0a0f;
    --color-bg-secondary: #13131a;
    --color-text: #e8e8ee;
    --color-text-muted: #9d9daa;
    --color-accent-turquoise: #06d6a0;
    --color-accent-purple: #a855f7;
    --color-accent-purple-dark: #7c3aed;
    
    /* Spacing */
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 6rem;
    --spacing-2xl: 8rem;
    
    /* Typography */
     --font-display: 'Space Mono', monospace;
     --font-body: 'JetBrains Mono', monospace;
  }

  /* ============================================
     Global Styles
     ============================================ */
  
  main {
    background: var(--color-bg);
    color: var(--color-text);
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  /* ============================================
     Hero Section
     ============================================ */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: var(--spacing-2xl) 0 var(--spacing-xl);
  }

    .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
  }


  .hero-content {
    position: relative;
    z-index: 1;
  }

  .glitch-text {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .glitch-text .line {
    display: block;
    animation: slideInLeft 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glitch-text .line:nth-child(2) {
    animation-delay: 0.1s;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }



  /* Emphasis (em) tyyli */

  .subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-text-muted);
    max-width: 650px;
    line-height: 1.8;
    animation: fadeIn 1s ease-out 0.5s both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ============================================
     What I Do Section
     ============================================ */
  .what-i-do {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg-secondary);
    position: relative;
  }

  .what-i-do::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-turquoise), transparent);
  }

  .what-i-do h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-md);
  }

  .card {
    background: var(--color-bg);
    padding: var(--spacing-md);
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.33);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-turquoise), var(--color-accent-purple));
    transform: scaleX(0);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .card:hover::before {
    transform: scaleX(1);
  }

  .card:hover {
    border-color: rgba(168, 85, 247, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(168, 85, 247, 0.2);
  }

  .card-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .card p {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* ============================================
     Projects & Case Studies Section
     ============================================ */
  .projects-section {
    padding: var(--spacing-xl) 0;
    background: var(--color-bg);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text);
  }

  /* Featured Project */
  .featured-project {
    background: linear-gradient(135deg, 
      rgba(6, 214, 160, 0.08), 
      rgba(168, 85, 247, 0.08)
    );
    border: 1px solid rgba(6, 214, 160, 0.3);
    border-radius: 8px;
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    position: relative;
    transition: all 0.3s ease;
  }

  .featured-project:hover {
    border-color: rgba(6, 214, 160, 0.5);
    box-shadow: 0 10px 40px rgba(6, 214, 160, 0.15);
  }

  .badge {
    display: inline-block;
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
    padding: 0.35rem 0.85rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--spacing-sm);
    font-family: var(--font-display);
  }

  .featured-project h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .project-description {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
    color: var(--color-text-muted);
    max-width: 800px;
  }

  .project-tech {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-md);
  }

  .tech-tag {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 4px;
    color: var(--color-accent-purple);
  }

  .project-links {
    display: flex;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .project-links a {
    font-family: var(--font-body);
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .link-github {
    background: var(--color-accent-turquoise);
    color: var(--color-bg);
  }

  .link-github:hover {
    background: var(--color-accent-purple);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(6, 214, 160, 0.3);
  }

  .link-docs {
    border: 1px solid var(--color-accent-purple);
    color: var(--color-accent-purple);
  }

  .link-docs:hover {
    background: rgba(168, 85, 247, 0.1);
  }

  .coming-soon-tag {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  /* Case Studies */
  .subsection-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-md);
    color: var(--color-text-muted);
    text-align: center;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-md);
  }

    .status-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    font-weight: 500;
    margin-top: 2rem;
  }

  .status-published {
  background: rgba(99, 102, 241, 0.15);  /* Indigo tausta */
  color: #818cf8;                         /* Indigo teksti */
  border: 1px solid rgba(99, 102, 241, 0.3);  /* Indigo reunus */
  }

    .status-planned {
    background: rgba(157, 157, 170, 0.15);
    color: var(--color-text-muted);
    border: 1px solid rgba(157, 157, 170, 0.3);
  }

  .case-placeholder {
